index 0000000..829b256
--- /dev/null
+++ b/libfprint/drivers/egis0570touch-proto.h
@@ -0,0 +1,122 @@
+/*
+ * Egis Technology Inc. (aka. LighTuning) 0570 driver for libfprint
+ * Copyright (C) 2021 Maxim Kolesnikov <kolesnikov@svyazcom.ru>
+ * Copyright (C) 2021 Saeed/Ali Rk <saeed.ali.rahimi@gmail.com>
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA
+ */
+
+#ifndef __EGIS0570TOUCH_PROTO_H
+
+#define __EGIS0570TOUCH_PROTO_H 1
+
+/*
+ * Device data
+ */
+
+#define EGIS0570_INTF 0
+
+/*
+ * Device endpoints
+ */
+
+#define EGIS0570_EPOUT 0x04 /* ( 4 | FPI_USB_ENDPOINT_OUT ) */
+#define EGIS0570_EPIN 0x83  /* ( 3 | FPI_USB_ENDPOINT_IN ) */
+
+/*
+ * Initialization packets (7 bytes each)
+ *
+ * First 4 bytes are equivalent to string "EGIS", which must be just a company identificator
+ * Other 3 bytes are not recognized yet and may be not important, as they are always the same
+
+ * Answers for each packet contain 7 bytes again
+ * First 4 bytes are reversed "EGIS", which is "SIGE", which is company ID again
+ * Other 3 bytes are not recognized yet
+ * But there is a pattern.
+ * Sending last packet makes sensor return image
+ */
+
+#define EGIS0570_TIMEOUT 10000
+#define EGIS0570_PKTSIZE 7
+
+#define EGIS0570_INIT_TOTAL (sizeof ((init_pkts)) / sizeof ((init_pkts[0])))
+
+static const unsigned char init_pkts[][EGIS0570_PKTSIZE] = {
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x10, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x11, 0x38},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x12, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x13, 0x71},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x20, 0x3f},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x58, 0x3f},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x21, 0x07},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x57, 0x07},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x22, 0x02},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x56, 0x02},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x23, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x55, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x24, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x54, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x25, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x53, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x15, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x16, 0x3b},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x09, 0x0a},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x14, 0x00},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x0f},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x03, 0x80},
+	{0x45, 0x47, 0x49, 0x53, 0x00, 0x02, 0x80},
+	{0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x2f},
+	{0x45, 0x47, 0x49, 0x53, 0x06, 0x00, 0xfe}
+};
+
+/*
+ * After sending initial packets device returns image data (32512 bytes)
+ * To ask device to send image data again, host needs to send four additional packets
+ * Further work is to repeatedly send four repeat packets and read image data
+ */
+
+#define EGIS0570_INPSIZE 32512
+
+/* 5 image with captured in different time of size 114 * 57 = 6498
+ * 5 * 6498 = 32490 plus 22 extra unrecognized char size data
+ * Two continuous image in this 5 images may have time delay of less than 20ms
+ */
+
+#define EGIS0570_IMGSIZE 6498
+#define EGIS0570_IMGWIDTH 114
+#define EGIS0570_IMGHEIGHT 57
+
+#define EGIS0570_IMGCOUNT 5
+
+/*
+ * Image repeat request
+ * First 4 bytes are the same as in initialization packets
+ * Have no idea what the other 3 bytes mean
+ */
+
+#define EGIS0570_REPEAT_TOTAL (sizeof ((repeat_pkts)) / sizeof ((repeat_pkts[0])))
+
+static const unsigned char repeat_pkts[][EGIS0570_PKTSIZE] =
+{
+  { 0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x0f },
+  { 0x45, 0x47, 0x49, 0x53, 0x00, 0x02, 0x0f },
+  { 0x45, 0x47, 0x49, 0x53, 0x01, 0x02, 0x2f },
+  { 0x45, 0x47, 0x49, 0x53, 0x06, 0x00, 0xfe }         /* image returned after this packet */
+};
+
+/* Minimum foreground signal for finger presence detection. */
+#define EGIS0570_MIN_MEAN 20
+
+#endif
diff --git a/libfprint/drivers/egis0570touch.c b/libfprint/drivers/egis0570touch.c
new file mode 100644
index 0000000..14405ed
--- /dev/null
+++ b/libfprint/drivers/egis0570touch.c
@@ -0,0 +1,980 @@
+/*
+ * Egis 0570 press driver. LGPL-2.1-or-later.
+ * USB protocol and initialization derived from the existing egis0570 driver
+ * by Maxim Kolesnikov and Saeed/Ali Rk, and the Acer Swift 1 patch.
+ */
+#define FP_COMPONENT "egis0570"
+#include "drivers_api.h"
+#include "egis0570touch-proto.h"
+#include "egis0570touch-match.h"
+#include <errno.h>
+#include <math.h>
+#include <stdlib.h>
+#include <glib/gstdio.h>
+
+#define FRAME_PIXELS (EGIS0570_IMGWIDTH * EGIS0570_IMGHEIGHT)
+#define MAX_FRAMES 50
+#define AUTH_FRAMES 10
+#define ENROLL_STAGES 20
+#define RELEASE_FRAMES 5
+/* Recalibrate when more than RECAL_PIXELS of the 17-row presence band read
+ * more than RECAL_DROP below the reference (5% of 969 pixels). With a correct
+ * reference (the minimum of 5 frames) this does not happen; with one taken
+ * on a finger, 15-22% of the band does (datasets/live3). */
+#define RECAL_DROP 15
+#define RECAL_PIXELS ((17 * EGIS0570_IMGWIDTH) / 20)
+/* NCC score threshold. 0.38 (calibrated on one 10-press impostor finger) let
+ * unenrolled fingers through in the field: on scripts/live3_eval.py with 41
+ * presses from 4 unenrolled fingers, impostor max is 0.468 and 12 score >= 0.38.
+ * 0.49 is that max + 0.02; genuine accept there is ~78% per press, recovered
+ * by the lock screen's unlimited retries. Override with
+ * EGIS0570_NCC_THRESHOLD for field tuning without a rebuild. */
+#define MATCH_THRESHOLD_DEFAULT 0.49
+/* Verification scores these frames of the AUTH_FRAMES burst (chronological
+ * slots) and keeps the best: on the cross-session evaluation in
+ * scripts/xsession_report.py this lifts the genuine accept rate from 80% to
+ * 90% with no impostor above 0.33. They are tried strongest first, so an
+ * accepting frame is usually found on the first try. */
+static const guint verify_frames[] = { 1, 3, 5, 7, 9 };
+#define N_VERIFY_FRAMES G_N_ELEMENTS (verify_frames)
+
+/* Adaptive templates: a successful verification whose score is far above the
+ * threshold, and which also matches the ORIGINAL enrollment on its own,
+ * appends that capture to a per-print side store so the gallery follows
+ * slow changes of the skin (dryness, season) without re-enrolling.
+ *   - ADAPT_MIN_SCORE: overall best score needed to learn from a capture
+ *   - ADAPT_ANCHOR_SCORE: the capture must also score this high against the
+ *     original enrollment alone, so learned samples can never chain away
+ *     from it
+ *   - ADAPT_DUP_SCORE: skip captures that duplicate an existing sample
+ *   - at most ADAPT_MAX samples; the oldest is dropped first
+ *   - learned samples accept only at threshold + ADAPT_LEARNED_MARGIN
+ * The store is keyed by a SHA-256 of the enrolled template, so deleting or
+ * re-enrolling a finger orphans its learned samples automatically. */
+#define ADAPT_MIN_SCORE 0.60
+#define ADAPT_ANCHOR_SCORE 0.55
+#define ADAPT_DUP_SCORE 0.85
+/* A match against a learned sample must clear threshold + this margin
+ * (0.49 + 0.11 = 0.60). On scripts/live3_adapt.py, unenrolled fingers scored
+ * up to 0.498 against the grown gallery while staying below 0.468 against the
+ * original enrollment: learned samples cover more skin, so coincidences are
+ * likelier and need a stricter bar. */
+#define ADAPT_LEARNED_MARGIN 0.11
+#define ADAPT_MAX 20
+#define ADAPT_DIR "/var/lib/fprint/.egis0570-adaptive"
+#define ADAPT_MAGIC 0x31304145u /* "EA01" */
+
+static double
+match_threshold (void)
+{
+  const char *override = getenv ("EGIS0570_NCC_THRESHOLD");
+  if (override && *override)
+    {
+      char *end = NULL;
+      double value = g_ascii_strtod (override, &end);
+      if (end != override && isfinite (value))
+        return value;
+    }
+  return MATCH_THRESHOLD_DEFAULT;
+}
+
+struct _FpDeviceEgis0570Touch
+{
+  FpDevice parent;
+  FpiSsm *ssm;
+  guint command;
+  gboolean initializing;
+  gboolean calibrated;
+  gboolean present;
+  gboolean wait_for_removal;
+  guint absent_frames;
+  guint frame_count;
+  guint16 background[FRAME_PIXELS];
+  guint16 *frames;
+  double scores[MAX_FRAMES];
+  guint8 packet[EGIS0570_INPSIZE];
+  GPtrArray *blobs;
+  gboolean finished;
+};
+G_DECLARE_FINAL_TYPE (FpDeviceEgis0570Touch, fpi_device_egis0570touch,
+                      FPI, DEVICE_EGIS0570TOUCH, FpDevice);
+G_DEFINE_TYPE (FpDeviceEgis0570Touch, fpi_device_egis0570touch, FP_TYPE_DEVICE);
+
+enum { SEND_COMMAND, RECEIVE_REPLY, RECEIVE_FRAMES, PROCESS_FRAMES, MATCH_FRAMES, N_STATES };
+
+/* Owned by a GTask. Templates are immutable snapshots; only the main thread
+ * accesses FpPrint objects or reports results to libfprint. */
+typedef struct
+{
+  FpiDeviceAction action;
+  GPtrArray *templates;
+  GBytes *enrollment;
+} MatchData;
+
+static void
+match_data_free (MatchData *data)
+{
+  g_ptr_array_unref (data->templates);
+  g_clear_pointer (&data->enrollment, g_bytes_unref);
+  g_free (data);
+}
+
+static const char *
+adapt_dir (void)
+{
+  const char *dir = getenv ("EGIS0570_ADAPT_DIR");
+  return dir && *dir ? dir : ADAPT_DIR;
+}
+
+static gboolean
+adapt_enabled (void)
+{
+  /* Off by default: learned samples widen each finger's coverage, and every
+   * extra sample is another chance for an unenrolled finger to align by
+   * coincidence (two field false accepts came through learned samples). */
+  const char *v = getenv ("EGIS0570_ADAPT");
+  return v && g_str_equal (v, "1");
+}
+
+static char *
+adapt_path (GVariant *template)
+{
+  g_autofree char *sum = g_compute_checksum_for_data (G_CHECKSUM_SHA256,
+                                                      g_variant_get_data (template),
+                                                      g_variant_get_size (template));
+  return g_strdup_printf ("%s/%s.bin", adapt_dir (), sum);
+}
+
+/* Returns the learned blobs of @template (oldest first); empty on any error. */
+static GPtrArray *
+adapt_load (GVariant *template)
+{
+  GPtrArray *out = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  g_autofree char *path = adapt_path (template);
+  g_autofree char *buf = NULL;
+  gsize len = 0, off = 8;
+  if (!g_file_get_contents (path, &buf, &len, NULL) || len < 8)
+    return out;
+  guint32 magic, count;
+  memcpy (&magic, buf, 4);
+  memcpy (&count, buf + 4, 4);
+  magic = GUINT32_FROM_LE (magic);
+  count = GUINT32_FROM_LE (count);
+  if (magic != ADAPT_MAGIC || count > ADAPT_MAX)
+    return out;
+  for (guint32 i = 0; i < count; i++)
+    {
+      guint32 n;
+      if (off + 4 > len)
+        break;
+      memcpy (&n, buf + off, 4);
+      n = GUINT32_FROM_LE (n);
+      off += 4;
+      if (n == 0 || n > len - off)
+        break;
+      g_ptr_array_add (out, g_bytes_new (buf + off, n));
+      off += n;
+    }
+  return out;
+}
+
+static void
+adapt_save (GVariant *template, GPtrArray *blobs)
+{
+  g_autofree char *path = adapt_path (template);
+  g_autoptr(GByteArray) out = g_byte_array_new ();
+  guint first = blobs->len > ADAPT_MAX ? blobs->len - ADAPT_MAX : 0;
+  guint32 v = GUINT32_TO_LE (ADAPT_MAGIC);
+  g_byte_array_append (out, (guint8 *) &v, 4);
+  v = GUINT32_TO_LE (blobs->len - first);
+  g_byte_array_append (out, (guint8 *) &v, 4);
+  for (guint i = first; i < blobs->len; i++)
+    {
+      gsize n;
+      const guint8 *d = g_bytes_get_data (g_ptr_array_index (blobs, i), &n);
+      v = GUINT32_TO_LE ((guint32) n);
+      g_byte_array_append (out, (guint8 *) &v, 4);
+      g_byte_array_append (out, d, n);
+    }
+  g_autoptr(GError) error = NULL;
+  if (g_mkdir_with_parents (adapt_dir (), 0700) != 0 ||
+      !g_file_set_contents_full (path, (const char *) out->data, out->len,
+                                 G_FILE_SET_CONTENTS_CONSISTENT, 0600, &error))
+    fp_warn ("adaptive store write failed: %s", error ? error->message : g_strerror (errno));
+}
+
+/* One enrolled print, decoded once per operation: the original samples and
+ * the learned ones, each as features whose FFT spectra get cached on use. */
+typedef struct
+{
+  GPtrArray *original; /* Egis0570TouchFeatures* */
+  GPtrArray *learned;  /* Egis0570TouchFeatures* */
+  GPtrArray *learned_blobs; /* GBytes*, parallel to learned */
+  gint64 adapt_stamp; /* side-store mtime/size when loaded, -1 if absent */
+  gint refs;
+} Gallery;
+
+static void
+gallery_free (Gallery *g)
+{
+  if (!g || !g_atomic_int_dec_and_test (&g->refs))
+    return;
+  g_clear_pointer (&g->original, g_ptr_array_unref);
+  g_clear_pointer (&g->learned, g_ptr_array_unref);
+  g_clear_pointer (&g->learned_blobs, g_ptr_array_unref);
+  g_free (g);
+}
+
+static Gallery *
+gallery_ref (Gallery *g)
+{
+  g_atomic_int_inc (&g->refs);
+  return g;
+}
+
+/* Decoded galleries (with their lazily computed FFT spectra) survive across
+ * operations, keyed by the SHA-256 of the enrolled template, so an unlock
+ * does not recompute the spectra of every stored sample. An entry is
+ * reloaded when the adaptive side store changed underneath it (deleted,
+ * disabled, rewritten). */
+static GMutex gallery_cache_lock;
+static GHashTable *gallery_cache_table;
+
+static gint64
+adapt_stamp (GVariant *template)
+{
+  if (!adapt_enabled ())
+    return -2;
+  g_autofree char *path = adapt_path (template);
+  GStatBuf st;
+  if (g_stat (path, &st) != 0)
+    return -1;
+  return ((gint64) st.st_mtim.tv_sec * 1000000000 + st.st_mtim.tv_nsec) ^ ((gint64) st.st_size << 40);
+}
+
+static char *
+template_key (GVariant *data)
+{
+  return g_compute_checksum_for_data (G_CHECKSUM_SHA256, g_variant_get_data (data),
+                                      g_variant_get_size (data));
+}
+
+static Gallery *
+gallery_load (GVariant *data)
+{
+  g_autoptr(GVariant) samples = NULL;
+  guint version;
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uaay)")))
+    return NULL;
+  g_variant_get (data, "(u@aay)", &version, &samples);
+  if (version != 1 || g_variant_n_children (samples) != ENROLL_STAGES)
+    return NULL;
+  Gallery *g = g_new0 (Gallery, 1);
+  g->refs = 1;
+  g->original = g_ptr_array_new_with_free_func ((GDestroyNotify) fpi_egis0570touch_features_free);
+  g->learned = g_ptr_array_new_with_free_func ((GDestroyNotify) fpi_egis0570touch_features_free);
+  g->learned_blobs = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  for (gsize i = 0; i < g_variant_n_children (samples); i++)
+    {
+      g_autoptr(GVariant) sample = g_variant_get_child_value (samples, i);
+      gsize size;
+      const guint8 *bytes = g_variant_get_fixed_array (sample, &size, 1);
+      g_autoptr(GBytes) blob = g_bytes_new (bytes, size);
+      Egis0570TouchFeatures *f = fpi_egis0570touch_features_deserialise (blob);
+      if (f)
+        g_ptr_array_add (g->original, f);
+    }
+  if (adapt_enabled ())
+    {
+      g_autoptr(GPtrArray) blobs = adapt_load (data);
+      for (guint i = 0; i < blobs->len; i++)
+        {
+          Egis0570TouchFeatures *f = fpi_egis0570touch_features_deserialise (g_ptr_array_index (blobs, i));
+          if (!f)
+            continue;
+          g_ptr_array_add (g->learned, f);
+          g_ptr_array_add (g->learned_blobs, g_bytes_ref (g_ptr_array_index (blobs, i)));
+        }
+    }
+  g->adapt_stamp = adapt_stamp (data);
+  return g;
+}
+
+/* Returns a new reference to the decoded gallery of @data, reusing the one
+ * from earlier operations when the side store has not changed since. */
+static Gallery *
+gallery_get (GVariant *data)
+{
+  if (!data || !g_variant_is_of_type (data, G_VARIANT_TYPE ("(uaay)")))
+    return NULL;
+  g_autofree char *key = template_key (data);
+  gint64 stamp = adapt_stamp (data);
+  g_mutex_lock (&gallery_cache_lock);
+  if (!gallery_cache_table)
+    gallery_cache_table = g_hash_table_new_full (g_str_hash, g_str_equal, g_free,
+                                                 (GDestroyNotify) gallery_free);
+  Gallery *g = g_hash_table_lookup (gallery_cache_table, key);
+  if (g && g->adapt_stamp == stamp)
+    {
+      gallery_ref (g);
+      g_mutex_unlock (&gallery_cache_lock);
+      return g;
+    }
+  g_mutex_unlock (&gallery_cache_lock);
+  g = gallery_load (data);
+  if (!g)
+    return NULL;
+  g_mutex_lock (&gallery_cache_lock);
+  /* Bound the cache: a user has a handful of fingers; anything past that
+   * is stale (deleted/re-enrolled prints whose key never comes back). */
+  if (g_hash_table_size (gallery_cache_table) >= 16)
+    g_hash_table_remove_all (gallery_cache_table);
+  g_hash_table_replace (gallery_cache_table, g_steal_pointer (&key), gallery_ref (g));
+  g_mutex_unlock (&gallery_cache_lock);
+  return g;
+}
+
+static double
+best_against (Egis0570TouchFeatures *probe, GPtrArray *set, GCancellable *cancellable)
+{
+  double best = -1.0;
+  for (guint i = 0; set && i < set->len; i++)
+    {
+      if (g_cancellable_is_cancelled (cancellable))
+        break;
+      best = MAX (best, fpi_egis0570touch_features_compare (probe, g_ptr_array_index (set, i)));
+    }
+  return best;
+}
+
+/* A learned-sample score, shifted so it competes against the plain threshold
+ * like an original-enrollment score: raw >= threshold + margin to accept. */
+static double
+learned_score (double raw)
+{
+  return raw < -1.0 + 1e-9 ? raw : raw - ADAPT_LEARNED_MARGIN;
+}
+
+static void
+report_retry (FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  GError *error = fpi_device_retry_new (self->present ? FP_DEVICE_RETRY_REMOVE_FINGER :
+                                      FP_DEVICE_RETRY_GENERAL);
+  switch ((gint) fpi_device_get_current_action (dev))
+    {
+    case FPI_DEVICE_ACTION_ENROLL:
+      fpi_device_enroll_progress (dev, self->blobs->len, NULL, error);
+      break;
+    case FPI_DEVICE_ACTION_VERIFY:
+      fpi_device_verify_report (dev, FPI_MATCH_ERROR, NULL, error);
+      self->finished = TRUE;
+      break;
+    case FPI_DEVICE_ACTION_IDENTIFY:
+      fpi_device_identify_report (dev, NULL, NULL, error);
+      self->finished = TRUE;
+      break;
+    default:
+      g_error_free (error);
+      g_assert_not_reached ();
+    }
+}
+
+/* Scores probes [from, to) against one print, folding into the running
+ * *best / *best_orig / *best_frame (initialise them to -1 / -1 / 0). Probes
+ * are ordered strongest frame first. Learned-sample scores are lowered by
+ * ADAPT_LEARNED_MARGIN before they compete, so *best is directly comparable
+ * with the threshold. Returns the overall best. */
+static double
+score_print (GPtrArray *probes, guint from, guint to, Gallery *g, double threshold,
+             gboolean stop_early, GCancellable *cancellable,
+             double *best_io, double *best_orig, guint *best_frame)
+{
+  double best = *best_io;
+  for (guint f = from; f < to && f < probes->len; f++)
+    {
+      Egis0570TouchFeatures *probe = g_ptr_array_index (probes, f);
+      double o = best_against (probe, g->original, cancellable);
+      double l = learned_score (best_against (probe, g->learned, cancellable));
+      *best_orig = MAX (*best_orig, o);
+      if (MAX (o, l) > best)
+        {
+          best = MAX (o, l);
+          *best_frame = f;
+        }
+      /* Stop once the result can no longer change: accepted and confident
+       * enough to also decide the adaptive update. */
+      if (stop_early && *best_orig >= threshold && best >= ADAPT_MIN_SCORE)
+        break;
+    }
+  *best_io = best;
+  return best;
+}
+
+/* Learn @probe into the side store of @template when the match was
+ * confident (@best >= ADAPT_MIN_SCORE), anchored to the original enrollment
+ * (@best_orig >= ADAPT_ANCHOR_SCORE and >= threshold, so learned samples can
+ * never chain away from it) and not a near-duplicate of an existing sample.
+ * @best has learned scores lowered by ADAPT_LEARNED_MARGIN, so the duplicate
+ * test adds it back (conservative: skips a little more than needed). */
+static void
+maybe_learn (GVariant *template, Gallery *g, Egis0570TouchFeatures *probe,
+             double best, double best_orig, double threshold)
+{
+  if (!adapt_enabled () || best < ADAPT_MIN_SCORE ||
+      best_orig < MAX (threshold, ADAPT_ANCHOR_SCORE) ||
+      best_orig >= ADAPT_DUP_SCORE || best + ADAPT_LEARNED_MARGIN >= ADAPT_DUP_SCORE)
+    return;
+  g_autoptr(GBytes) blob = fpi_egis0570touch_features_serialise (probe);
+  if (!blob)
+    return;
+  g_ptr_array_add (g->learned_blobs, g_bytes_ref (blob));
+  adapt_save (template, g->learned_blobs);
+  /* Keep the cached gallery in step with the side store: append the new
+   * sample (spectrum computed lazily on its first comparison) and drop the
+   * oldest beyond ADAPT_MAX, matching adapt_save()'s trimming. */
+  Egis0570TouchFeatures *copy = fpi_egis0570touch_features_deserialise (blob);
+  if (copy)
+    g_ptr_array_add (g->learned, copy);
+  while (g->learned_blobs->len > ADAPT_MAX)
+    g_ptr_array_remove_index (g->learned_blobs, 0);
+  while (g->learned->len > ADAPT_MAX)
+    g_ptr_array_remove_index (g->learned, 0);
+  g->adapt_stamp = adapt_stamp (template);
+  fp_info ("adaptive: learned a new sample (score %.3f, %u stored)", best,
+           MIN (g->learned_blobs->len, ADAPT_MAX));
+}
+
+static void
+match_frames (GTask *task, gpointer source_object, gpointer task_data,
+              GCancellable *cancellable)
+{
+  FpDeviceEgis0570Touch *self = source_object;
+  MatchData *data = task_data;
+  gint winner = -1;
+  double threshold = match_threshold ();
+  double best = threshold - 1e-9;
+  gint64 t0 = g_get_monotonic_time ();
+
+  /* The USB state machine is paused until this task finishes. */
+  if (g_task_return_error_if_cancelled (task))
+    return;
+  if (self->frame_count < AUTH_FRAMES)
+    {
+      g_task_return_error (task, fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+      return;
+    }
+  fpi_egis0570touch_dump_frames (data->action == FPI_DEVICE_ACTION_ENROLL ? "e" : "v",
+                                 self->frames, self->frame_count, self->background);
+
+  if (data->action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      g_autoptr(Egis0570TouchFeatures) features =
+        fpi_egis0570touch_features_extract (self->frames, self->frame_count, self->background, TRUE);
+      if (features)
+        data->enrollment = fpi_egis0570touch_features_serialise (features);
+      if (!data->enrollment)
+        {
+          g_task_return_error (task, fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+          return;
+        }
+      g_task_return_int (task, -1);
+      return;
+    }
+
+  g_autoptr(GPtrArray) probes =
+    g_ptr_array_new_with_free_func ((GDestroyNotify) fpi_egis0570touch_features_free);
+  guint order[N_VERIFY_FRAMES];
+  double strength[N_VERIFY_FRAMES];
+  guint n_order = N_VERIFY_FRAMES;
+  for (guint k = 0; k < n_order; k++)
+    {
+      order[k] = MIN (verify_frames[k], self->frame_count - 1);
+      strength[k] = fpi_egis0570touch_frame_strength (self->frames + order[k] * FRAME_PIXELS, self->background);
+    }
+  /* insertion sort, strongest first, keeping order[] and strength[] paired */
+  for (guint a = 1; a < n_order; a++)
+    for (guint b = a; b > 0 && strength[b] > strength[b - 1]; b--)
+      {
+        guint t = order[b]; order[b] = order[b - 1]; order[b - 1] = t;
+        double u = strength[b]; strength[b] = strength[b - 1]; strength[b - 1] = u;
+      }
+  guint probe_slot[N_VERIFY_FRAMES];
+  for (guint k = 0; k < n_order; k++)
+    {
+      Egis0570TouchFeatures *f =
+        fpi_egis0570touch_features_extract (self->frames + order[k] * FRAME_PIXELS, 1, self->background, FALSE);
+      if (f)
+        {
+          probe_slot[probes->len] = order[k];
+          g_ptr_array_add (probes, f);
+        }
+    }
+  if (probes->len == 0)
+    {
+      g_task_return_error (task, fpi_device_retry_new (FP_DEVICE_RETRY_GENERAL));
+      return;
+    }
+
+  /* Pass 1 scores only the strongest frame against every print, so the
+   * enrolled finger that is actually on the sensor is usually accepted after
+   * a single print instead of after all the others were searched in full.
+   * Pass 2 adds the remaining frames for the prints still undecided. */
+  guint n_prints = data->templates->len;
+  g_autofree Gallery **gal = g_new0 (Gallery *, MAX (n_prints, 1));
+  g_autofree double *sc = g_new (double, MAX (n_prints, 1));
+  g_autofree double *orig = g_new (double, MAX (n_prints, 1));
+  g_autofree guint *frame = g_new0 (guint, MAX (n_prints, 1));
+  gboolean stop = FALSE;
+  for (guint pass = 0; pass < 2 && !stop; pass++)
+    for (guint i = 0; i < n_prints && !stop; i++)
+      {
+        if (g_cancellable_is_cancelled (cancellable))
+          {
+            stop = TRUE;
+            break;
+          }
+        if (pass == 0)
+          {
+            sc[i] = -1.0; orig[i] = -1.0; frame[i] = 0;
+            gal[i] = gallery_get (g_ptr_array_index (data->templates, i));
+          }
+        if (!gal[i])
+          continue;
+        /* Pass 2 only matters when pass 1 did not settle this print. */
+        if (pass == 1 && orig[i] >= threshold && sc[i] >= ADAPT_MIN_SCORE)
+          continue;
+        score_print (probes, pass == 0 ? 0 : 1, pass == 0 ? 1 : probes->len, gal[i],
+                     threshold, TRUE, cancellable, &sc[i], &orig[i], &frame[i]);
+        fp_info ("pass %u print %u: score %.3f (original-only %.3f, frame %u, %u learned, threshold %.3f)",
+                 pass + 1, i, sc[i], orig[i], probe_slot[frame[i]], gal[i]->learned->len, threshold);
+        if (sc[i] > best)
+          {
+            best = sc[i];
+            winner = i;
+          }
+        if (winner >= 0 && data->action == FPI_DEVICE_ACTION_VERIFY)
+          stop = TRUE;
+      }
+  Gallery *win_gallery = NULL;
+  double win_orig = -1.0;
+  guint win_frame = 0;
+  for (guint i = 0; i < n_prints; i++)
+    {
+      if ((gint) i == winner)
+        {
+          win_gallery = gal[i];
+          win_orig = orig[i];
+          win_frame = frame[i];
+        }
+      else if (gal[i])
+        gallery_free (gal[i]);
+    }
+  if (g_task_return_error_if_cancelled (task))
+    {
+      g_clear_pointer (&win_gallery, gallery_free);
+      return;
+    }
+  if (win_gallery)
+    {
+      maybe_learn (g_ptr_array_index (data->templates, winner), win_gallery,
+                   g_ptr_array_index (probes, win_frame), best, win_orig, threshold);
+      gallery_free (win_gallery);
+    }
+  fp_info ("match done in %.0f ms, winner %d", (g_get_monotonic_time () - t0) / 1000.0, winner);
+  g_task_return_int (task, winner);
+}
+
+static void
+match_done (GObject *source_object, GAsyncResult *result, gpointer unused)
+{
+  FpDevice *dev = FP_DEVICE (source_object);
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  MatchData *data = g_task_get_task_data (G_TASK (result));
+  g_autoptr(GError) error = NULL;
+  gint winner = g_task_propagate_int (G_TASK (result), &error);
+
+  if (error)
+    {
+      if (error->domain != FP_DEVICE_RETRY)
+        {
+          fpi_ssm_mark_failed (self->ssm, g_steal_pointer (&error));
+          return;
+        }
+      report_retry (dev);
+    }
+  else switch ((gint) data->action)
+    {
+    case FPI_DEVICE_ACTION_ENROLL:
+      g_ptr_array_add (self->blobs, g_steal_pointer (&data->enrollment));
+      fpi_device_enroll_progress (dev, self->blobs->len, NULL, NULL);
+      self->finished = self->blobs->len == ENROLL_STAGES;
+      break;
+    case FPI_DEVICE_ACTION_VERIFY:
+      fpi_device_verify_report (dev, winner >= 0 ? FPI_MATCH_SUCCESS : FPI_MATCH_FAIL,
+                                NULL, NULL);
+      self->finished = TRUE;
+      break;
+    case FPI_DEVICE_ACTION_IDENTIFY:
+      {
+        GPtrArray *prints;
+        fpi_device_get_identify_data (dev, &prints);
+        fpi_device_identify_report (dev, winner >= 0 ? g_ptr_array_index (prints, winner) : NULL,
+                                    NULL, NULL);
+        self->finished = TRUE;
+        break;
+      }
+    default:
+      g_assert_not_reached ();
+    }
+  self->frame_count = 0;
+  if (self->finished)
+    fpi_ssm_mark_completed (self->ssm);
+  else
+    {
+      fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+      self->initializing = FALSE;
+      self->command = 0;
+      fpi_ssm_jump_to_state (self->ssm, SEND_COMMAND);
+    }
+}
+
+static gboolean
+process_packet (FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  if (!self->calibrated)
+    {
+      for (guint i = 0; i < FRAME_PIXELS; i++)
+        {
+          self->background[i] = 255;
+          for (guint k = 0; k < EGIS0570_IMGCOUNT; k++)
+            self->background[i] = MIN (self->background[i], self->packet[k * FRAME_PIXELS + i]);
+        }
+      self->calibrated = TRUE;
+      fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+      return FALSE;
+    }
+  for (guint k = 0; k < EGIS0570_IMGCOUNT && !self->finished; k++)
+    {
+      const guint8 *frame = self->packet + k * FRAME_PIXELS;
+      double mean = 0;
+      guint below = 0;
+      for (guint i = 20 * EGIS0570_IMGWIDTH; i < 37 * EGIS0570_IMGWIDTH; i++)
+        {
+          mean += MAX (0, (int) frame[i] - self->background[i]);
+          below += (int) frame[i] + RECAL_DROP < (int) self->background[i];
+        }
+      mean /= 17 * EGIS0570_IMGWIDTH;
+      /* The empty-sensor reference is the per-pixel minimum of the first
+       * packet after open. If a finger was already down then (common right
+       * after resume) or the first packet was garbage, the reference sits
+       * above the real empty sensor: every touch then reads as "no finger"
+       * until the device is reopened. An empty sensor can only read clearly
+       * BELOW a correct reference, so that is the signal to take a new one.
+       * This only affects presence detection, never matching. */
+      if (!self->present && below > RECAL_PIXELS)
+        {
+          fp_info ("background was taken with something on the sensor; recalibrating");
+          self->calibrated = FALSE;
+          self->wait_for_removal = FALSE;
+          return process_packet (dev);
+        }
+      /* Do not treat one held finger as several operations after a retry. */
+      if (self->wait_for_removal)
+        {
+          if (mean > EGIS0570_MIN_MEAN)
+            self->absent_frames = 0;
+          else if (++self->absent_frames >= RELEASE_FRAMES)
+            {
+              self->wait_for_removal = FALSE;
+              self->present = FALSE;
+              fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NEEDED);
+            }
+          continue;
+        }
+      if (mean > EGIS0570_MIN_MEAN)
+        {
+          self->absent_frames = 0;
+          if (!self->present)
+            {
+              self->present = TRUE;
+              fpi_device_report_finger_status (dev, FP_FINGER_STATUS_PRESENT);
+            }
+          guint slot = self->frame_count;
+          if (slot == MAX_FRAMES)
+            {
+              slot = 0;
+              for (guint i = 1; i < MAX_FRAMES; i++)
+                if (self->scores[i] < self->scores[slot])
+                  slot = i;
+              if (mean <= self->scores[slot])
+                continue;
+            }
+          else
+            self->frame_count++;
+          self->scores[slot] = mean;
+          for (guint i = 0; i < FRAME_PIXELS; i++)
+            self->frames[slot * FRAME_PIXELS + i] = frame[i];
+          /* Authentication uses one batch; enrollment waits for removal. */
+          if (self->frame_count == AUTH_FRAMES &&
+              fpi_device_get_current_action (dev) != FPI_DEVICE_ACTION_ENROLL)
+            return TRUE;
+        }
+      else if (self->present && ++self->absent_frames >= RELEASE_FRAMES)
+        {
+          self->present = FALSE;
+          fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NONE);
+          return TRUE;
+        }
+    }
+  return FALSE;
+}
+
+static void
+receive_frames_cb (FpiUsbTransfer *transfer, FpDevice *dev, gpointer unused, GError *error)
+{
+  if (error)
+    {
+      fpi_ssm_mark_failed (transfer->ssm, error);
+      return;
+    }
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  memcpy (self->packet, transfer->buffer, sizeof (self->packet));
+  fpi_ssm_next_state (transfer->ssm);
+}
+
+static void
+run_state (FpiSsm *ssm, FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  FpiUsbTransfer *transfer;
+  guint total = self->initializing ? EGIS0570_INIT_TOTAL : EGIS0570_REPEAT_TOTAL;
+  /* Drain each complete request/response cycle before honoring cancellation. */
+  if ((fpi_ssm_get_cur_state (ssm) == PROCESS_FRAMES ||
+       (fpi_ssm_get_cur_state (ssm) == SEND_COMMAND && self->command == 0)) &&
+      fpi_device_action_is_cancelled (dev))
+    {
+      fpi_ssm_mark_failed (ssm, g_error_new_literal (G_IO_ERROR, G_IO_ERROR_CANCELLED, "Cancelled"));
+      return;
+    }
+  switch (fpi_ssm_get_cur_state (ssm))
+    {
+    case SEND_COMMAND:
+      transfer = fpi_usb_transfer_new (dev);
+      transfer->ssm = ssm;
+      transfer->short_is_error = TRUE;
+      fpi_usb_transfer_fill_bulk (transfer, EGIS0570_EPOUT, EGIS0570_PKTSIZE);
+      memcpy (transfer->buffer, self->initializing ? init_pkts[self->command] : repeat_pkts[self->command], EGIS0570_PKTSIZE);
+      fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, fpi_ssm_usb_transfer_cb, NULL);
+      break;
+    case RECEIVE_REPLY:
+      if (self->command == total - 1)
+        fpi_ssm_next_state (ssm);
+      else
+        {
+          transfer = fpi_usb_transfer_new (dev);
+          transfer->ssm = ssm;
+          transfer->short_is_error = TRUE;
+          fpi_usb_transfer_fill_bulk (transfer, EGIS0570_EPIN, EGIS0570_PKTSIZE);
+          fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, fpi_ssm_usb_transfer_cb, NULL);
+        }
+      break;
+    case RECEIVE_FRAMES:
+      if (self->command < total - 1)
+        {
+          self->command++;
+          fpi_ssm_jump_to_state (ssm, SEND_COMMAND);
+          break;
+        }
+      transfer = fpi_usb_transfer_new (dev);
+      transfer->ssm = ssm;
+      transfer->short_is_error = TRUE;
+      fpi_usb_transfer_fill_bulk (transfer, EGIS0570_EPIN, EGIS0570_INPSIZE);
+      fpi_usb_transfer_submit (transfer, EGIS0570_TIMEOUT, NULL, receive_frames_cb, NULL);
+      break;
+    case PROCESS_FRAMES:
+      if (process_packet (dev))
+        fpi_ssm_next_state (ssm);
+      else
+        {
+          self->initializing = FALSE;
+          self->command = 0;
+          fpi_ssm_jump_to_state (ssm, SEND_COMMAND);
+        }
+      break;
+    case MATCH_FRAMES:
+      {
+        MatchData *data = g_new0 (MatchData, 1);
+        g_autoptr(GTask) task = g_task_new (dev, fpi_device_get_cancellable (dev),
+                                          match_done, NULL);
+        g_autoptr(GPtrArray) single = g_ptr_array_new ();
+        GPtrArray *prints = single;
+        data->action = fpi_device_get_current_action (dev);
+        data->templates = g_ptr_array_new_with_free_func ((GDestroyNotify) g_variant_unref);
+        if (data->action == FPI_DEVICE_ACTION_VERIFY)
+          {
+            FpPrint *print;
+            fpi_device_get_verify_data (dev, &print);
+            g_ptr_array_add (single, print);
+          }
+        else if (data->action == FPI_DEVICE_ACTION_IDENTIFY)
+          fpi_device_get_identify_data (dev, &prints);
+        for (guint i = 0; i < prints->len; i++)
+          {
+            GVariant *template = NULL;
+            g_object_get (g_ptr_array_index (prints, i), "fpi-data", &template, NULL);
+            /* Keep indices even for an old or invalid template. */
+            if (!template)
+              template = g_variant_ref_sink (g_variant_new_tuple (NULL, 0));
+            g_ptr_array_add (data->templates, template);
+          }
+        g_task_set_task_data (task, data, (GDestroyNotify) match_data_free);
+        g_task_run_in_thread (task, match_frames);
+      }
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+static void
+operation_complete (FpiSsm *ssm, FpDevice *dev, GError *error)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  self->ssm = NULL;
+  fpi_device_report_finger_status (dev, FP_FINGER_STATUS_NONE);
+  if (error)
+    {
+      fpi_device_action_error (dev, error);
+      return;
+    }
+  switch ((gint) fpi_device_get_current_action (dev))
+    {
+    case FPI_DEVICE_ACTION_ENROLL:
+      {
+        FpPrint *print;
+        GVariantBuilder builder;
+        fpi_device_get_enroll_data (dev, &print);
+        g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+        for (guint i = 0; i < self->blobs->len; i++)
+          {
+            gsize size;
+            const void *data = g_bytes_get_data (g_ptr_array_index (self->blobs, i), &size);
+            g_variant_builder_add_value (&builder, g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, data, size, 1));
+          }
+        fpi_print_set_type (print, FPI_PRINT_RAW);
+        fpi_print_set_device_stored (print, FALSE);
+        g_object_set (print, "fpi-data", g_variant_new ("(uaay)", 1u, &builder), NULL);
+        fpi_device_enroll_complete (dev, g_object_ref (print), NULL);
+        break;
+      }
+    case FPI_DEVICE_ACTION_VERIFY:
+      fpi_device_verify_complete (dev, NULL);
+      break;
+    case FPI_DEVICE_ACTION_IDENTIFY:
+      fpi_device_identify_complete (dev, NULL);
+      break;
+    default:
+      g_assert_not_reached ();
+    }
+}
+
+/* Per-operation capture state. Verify/identify: a finger already down at
+ * start is a fresh touch (the screen locker restarts the operation while the
+ * finger stays on the sensor). Only enrollment needs a lift between stages. */
+static void
+reset_capture (FpDeviceEgis0570Touch *self, FpiDeviceAction action)
+{
+  self->command = 0;
+  self->initializing = TRUE;
+  self->wait_for_removal = self->present && action == FPI_DEVICE_ACTION_ENROLL;
+  self->finished = FALSE;
+  self->absent_frames = 0;
+  self->frame_count = 0;
+}
+
+static void
+start_operation (FpDevice *dev)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  reset_capture (self, fpi_device_get_current_action (dev));
+  if (self->calibrated)
+    fpi_device_report_finger_status (dev, self->wait_for_removal ? FP_FINGER_STATUS_PRESENT :
+                                    FP_FINGER_STATUS_NEEDED);
+  g_ptr_array_set_size (self->blobs, 0);
+  self->ssm = fpi_ssm_new (dev, run_state, N_STATES);
+  fpi_ssm_start (self->ssm, operation_complete);
+}
+
+static void
+dev_open (FpDevice *dev)
+{
+  GError *error = NULL;
+  /* Keep the empty-sensor reference across operations on one open device.
+   * Recalibrating after every verification can mistake the next touch for
+   * background when the user presents their finger before capture starts. */
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (dev);
+  /* If the previous operation ended with a finger down, retain its reference
+   * until removal rather than calibrating that held finger as background. */
+  if (!self->present)
+    self->calibrated = FALSE;
+  g_usb_device_claim_interface (fpi_device_get_usb_device (dev), EGIS0570_INTF, 0, &error);
+  fpi_device_open_complete (dev, error);
+}
+
+static void
+dev_close (FpDevice *dev)
+{
+  GError *error = NULL;
+  g_usb_device_release_interface (fpi_device_get_usb_device (dev), EGIS0570_INTF, 0, &error);
+  fpi_device_close_complete (dev, error);
+}
+
+static void
+finalize (GObject *object)
+{
+  FpDeviceEgis0570Touch *self = FPI_DEVICE_EGIS0570TOUCH (object);
+  g_free (self->frames);
+  g_ptr_array_unref (self->blobs);
+  G_OBJECT_CLASS (fpi_device_egis0570touch_parent_class)->finalize (object);
+}
+
+static const FpIdEntry id_table[] = {
+  { .vid = 0x1c7a, .pid = 0x0570 },
+  { .vid = 0, .pid = 0 }
+};
+
+static void
+fpi_device_egis0570touch_init (FpDeviceEgis0570Touch *self)
+{
+  self->frames = g_new (guint16, MAX_FRAMES * FRAME_PIXELS);
+  self->blobs = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+}
+
+static void
+fpi_device_egis0570touch_class_init (FpDeviceEgis0570TouchClass *klass)
+{
+  FpDeviceClass *dev = FP_DEVICE_CLASS (klass);
+  G_OBJECT_CLASS (klass)->finalize = finalize;
+  /* Preserve the existing driver identity so fprintd selects this as the
+   * replacement implementation for 1c7a:0570. Old image templates fail the
+   * raw-template type check above and must be enrolled again. */
+  dev->id = "egis0570";
+  dev->full_name = "Egis Technology Inc. 0570 touch sensor";
+  dev->type = FP_DEVICE_TYPE_USB;
+  dev->id_table = id_table;
+  dev->scan_type = FP_SCAN_TYPE_PRESS;
+  dev->nr_enroll_stages = ENROLL_STAGES;
+  dev->open = dev_open;
+  dev->close = dev_close;
+  dev->enroll = start_operation;
+  dev->verify = start_operation;
+  dev->identify = start_operation;
+  /* Passive capacitive press sensor polled at idle: it does not heat up, and
+   * the screen locker keeps identify running for as long as the screen is
+   * locked. The default 3-minute "too hot" model would disable the reader
+   * mid-lock and silently stop fingerprint unlock. */
+  dev->temp_hot_seconds = -1;
+  fpi_device_class_auto_initialize_features (dev);
+}
