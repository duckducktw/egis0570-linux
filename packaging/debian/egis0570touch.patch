+/*
+ * High-pass NCC matching for the EgisTec 1c7a:0570 touch sensor.
+ * Copyright (C) 2026 Michael Brunner
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * On real hardware the previous SIFT/RANSAC matcher scored genuine
+ * same-finger presses at 0 (threshold 12): the sensor image is too small
+ * and low-contrast for stable keypoints. This replacement correlates whole
+ * images instead: background-subtract, crop the border, remove a slow
+ * Gaussian "shading" component (high-pass), denoise with a small blur,
+ * z-score, halve the resolution, then search a handful of rotations and
+ * every translation that still keeps at least half the area overlapping,
+ * reporting the largest normalised cross-correlation (NCC) found. This
+ * mirrors scripts/eval_matchers.py's hpimg()/ncc_shift() reference
+ * implementation closely enough that the two agree to within 0.02 on the
+ * same data (see REPORT2.md).
+ */
+
+#include "egis0570touch-match.h"
+
+#include <opencv2/imgproc.hpp>
+#include <opencv2/core/version.hpp>
+#if CV_VERSION_MAJOR >= 5
+/* OpenCV 5 moved getRotationMatrix2D() into the geometry module */
+#include <opencv2/geometry/2d.hpp>
+#endif
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <vector>
+#include <glib.h>
+
+namespace {
+
+/* Preprocessing, matching scripts/eval_matchers.py:hpimg() and the 0.5x
+ * resize applied before ncc_shift() in scripts/loo_eval.py. */
+constexpr double kHighpassSigma = 3.0;
+constexpr double kSmoothSigma = 0.8;
+constexpr double kLocalNormSigma = 4.0;
+constexpr double kDownscale = 0.5;
+
+/* A chosen frame whose cropped-signal standard deviation falls below this is
+ * treated as "no finger", not as a flat but genuine capture. Real presses in
+ * the reference dataset have a standard deviation several orders of
+ * magnitude above this; it only rejects degenerate all-background input. */
+constexpr double kMinSignalStd = 1e-3;
+
+/* Matching scripts/eval_matchers.py:ncc_shift() as called from
+ * scripts/loo_eval.py's second (overlap>=0.5) run, which is also the run
+ * whose measured numbers (genuine median 0.725, impostor max ~0.35 excluding
+ * the suspect B_other/1 press) motivate the 0.50 threshold below. */
+constexpr double kAngles[] = { -15, -10, -5, 0, 5, 10, 15 };
+constexpr double kMinOverlap = 0.5;
+
+constexpr uint32_t kBlobMagic = 0x45543032; /* bytes spell "ET02" */
+constexpr uint16_t kBlobVersion = 3; /* v3: local contrast normalisation */
+/* Z-scored values are stored as int16 scaled by this factor; z-scores on
+ * this dataset stay within roughly +/-6, far inside int16 range. */
+constexpr float kQuantScale = 1000.0f;
+
+constexpr int kCropWidth = EGIS0570TOUCH_WIDTH - 2 * EGIS0570TOUCH_BORDER;
+constexpr int kCropHeight = EGIS0570TOUCH_HEIGHT - 2 * EGIS0570TOUCH_BORDER;
+constexpr size_t kFramePixels =
+  static_cast<size_t> (EGIS0570TOUCH_WIDTH) * EGIS0570TOUCH_HEIGHT;
+
+void
+write_u16_le (uint8_t *buffer, uint16_t value)
+{
+  value = GUINT16_TO_LE (value);
+  memcpy (buffer, &value, sizeof (value));
+}
+
+void
+write_u32_le (uint8_t *buffer, uint32_t value)
+{
+  value = GUINT32_TO_LE (value);
+  memcpy (buffer, &value, sizeof (value));
+}
+
+void
+write_i16_le (uint8_t *buffer, int16_t value)
+{
+  uint16_t bits;
+  memcpy (&bits, &value, sizeof (bits));
+  write_u16_le (buffer, bits);
+}
+
+void
+write_float_le (uint8_t *buffer, float value)
+{
+  static_assert (sizeof (float) == sizeof (uint32_t));
+  uint32_t bits;
+  memcpy (&bits, &value, sizeof (bits));
+  write_u32_le (buffer, bits);
+}
+
+uint16_t
+read_u16_le (const uint8_t *buffer)
+{
+  uint16_t value;
+  memcpy (&value, buffer, sizeof (value));
+  return GUINT16_FROM_LE (value);
+}
+
+uint32_t
+read_u32_le (const uint8_t *buffer)
+{
+  uint32_t value;
+  memcpy (&value, buffer, sizeof (value));
+  return GUINT32_FROM_LE (value);
+}
+
+int16_t
+read_i16_le (const uint8_t *buffer)
+{
+  uint16_t bits = read_u16_le (buffer);
+  int16_t value;
+  memcpy (&value, &bits, sizeof (value));
+  return value;
+}
+
+float
+read_float_le (const uint8_t *buffer)
+{
+  const uint32_t bits = read_u32_le (buffer);
+  float value;
+  memcpy (&value, &bits, sizeof (value));
+  return value;
+}
+
+/* Sum of positive (frame - background) over the cropped region: a cheap
+ * proxy for "how much finger signal is in this frame", used to pick the
+ * strongest frame of an enrollment press. */
+double
+frame_strength (const uint16_t *frame, const uint16_t *background)
+{
+  double sum = 0.0;
+  for (int y = 0; y < kCropHeight; y++)
+    {
+      const size_t row = static_cast<size_t> (y + EGIS0570TOUCH_BORDER) * EGIS0570TOUCH_WIDTH;
+      for (int x = 0; x < kCropWidth; x++)
+        {
+          const size_t idx = row + x + EGIS0570TOUCH_BORDER;
+          const double d = static_cast<double> (frame[idx]) - static_cast<double> (background[idx]);
+          if (d > 0)
+            sum += d;
+        }
+    }
+  return sum;
+}
+
+/* diff -> crop border -> high-pass (subtract a wide Gaussian blur) ->
+ * light denoise blur -> z-score -> half resolution. Returns an empty Mat if
+ * the frame has no measurable signal (background not subtracted away from
+ * itself, i.e. no finger). */
+cv::Mat
+prepare_hp (const uint16_t *frame, const uint16_t *background)
+{
+  cv::Mat cropped (kCropHeight, kCropWidth, CV_32F);
+  for (int y = 0; y < kCropHeight; y++)
+    {
+      float *row = cropped.ptr<float> (y);
+      const size_t base = static_cast<size_t> (y + EGIS0570TOUCH_BORDER) * EGIS0570TOUCH_WIDTH;
+      for (int x = 0; x < kCropWidth; x++)
+        {
+          const size_t idx = base + x + EGIS0570TOUCH_BORDER;
+          row[x] = static_cast<float> (frame[idx]) - static_cast<float> (background[idx]);
+        }
+    }
+
+  cv::Mat lowpass;
+  cv::GaussianBlur (cropped, lowpass, cv::Size (0, 0), kHighpassSigma);
+  cv::Mat highpass = cropped - lowpass;
+
+  cv::Mat smoothed;
+  cv::GaussianBlur (highpass, smoothed, cv::Size (0, 0), kSmoothSigma);
+
+  cv::Scalar mean, stddev;
+  cv::meanStdDev (smoothed, mean, stddev);
+  if (stddev[0] < kMinSignalStd)
+    return cv::Mat ();
+
+  /* Local contrast normalisation: divide by the local RMS ridge amplitude so
+   * that pressure / dryness differences across the touch do not dominate the
+   * correlation (scripts/acc_harness.py:pre_localnorm, ln=4). */
+  cv::Mat energy;
+  cv::GaussianBlur (smoothed.mul (smoothed), energy, cv::Size (0, 0), kLocalNormSigma);
+  cv::sqrt (energy, energy);
+  energy += 1e-3 * stddev[0];
+  cv::Mat normed = smoothed / energy;
+  cv::meanStdDev (normed, mean, stddev);
+
+  cv::Mat z = (normed - mean[0]) / (stddev[0] + 1e-9);
+
+  cv::Mat half;
+  cv::resize (z, half, cv::Size (), kDownscale, kDownscale, cv::INTER_LINEAR);
+  return half;
+}
+
+/* Normalised cross-correlation of @a against @b over rotations of @b
+ * (kAngles) and every translation (|dy| <= h/2, |dx| <= w/2) that keeps at
+ * least kMinOverlap of the area in common, computed for all shifts at once
+ * with FFT-based masked NCC (Padfield, "Masked object registration in the
+ * Fourier domain", IEEE TIP 2012). Rotated-out pixels of @b are masked, so
+ * every shift's Pearson correlation is over exactly the valid overlap --
+ * numerically identical (to ~1e-7) to the brute-force definition in
+ * scripts/acc_harness.py:ncc_shift, verified by scripts/fftncc.py. */
+
+/* The validity mask of a rotated gallery image depends only on the image
+ * size and the angle, never on its content (rotation is the only source of
+ * masked pixels). Everything derived from the mask alone -- its spectrum,
+ * the overlap count and the set of admissible shifts -- is therefore shared
+ * by every sample and every probe, and is computed once per size. */
+struct RotationGeom
+{
+  cv::Mat mask;                /* CV_64F 0/1, h x w */
+  cv::Mat one;                 /* CCS spectrum of mask, padded to H x W */
+  std::vector<int> idx;        /* admissible shifts, iy * W + ix */
+  std::vector<double> inv_cnt; /* 1 / overlap pixel count */
+  std::vector<cv::Rect> rect;  /* gallery pixels overlapping the probe */
+};
+
+struct Geometry
+{
+  int h = 0, w = 0, H = 0, W = 0;
+  std::vector<RotationGeom> rot;
+};
+
+/* Real-input DFT in CCS-packed form (half the work of a complex DFT). */
+cv::Mat
+padded_dft (const cv::Mat &x, int H, int W)
+{
+  cv::Mat p = cv::Mat::zeros (H, W, CV_64F);
+  x.convertTo (p (cv::Rect (0, 0, x.cols, x.rows)), CV_64F);
+  cv::Mat f;
+  cv::dft (p, f);
+  return f;
+}
+
+/* c(s) = sum_p X(p + s) Y(p), s taken modulo (H, W). */
+cv::Mat
+xcorr (const cv::Mat &FX, const cv::Mat &FY)
+{
+  cv::Mat prod, r;
+  cv::mulSpectrums (FX, FY, prod, 0, true);
+  cv::idft (prod, r, cv::DFT_REAL_OUTPUT | cv::DFT_SCALE);
+  return r;
+}
+
+cv::Mat
+rotate_masked (const cv::Mat &b32, double angle)
+{
+  const int h = b32.rows, w = b32.cols;
+  cv::Mat rot = cv::getRotationMatrix2D (cv::Point2f (w / 2.0f, h / 2.0f), angle, 1.0);
+  cv::Mat br;
+  cv::warpAffine (b32, br, rot, cv::Size (w, h), cv::INTER_LINEAR, cv::BORDER_CONSTANT,
+                  cv::Scalar (std::numeric_limits<float>::quiet_NaN ()));
+  return br;
+}
+
+/* Sum of an integral image (CV_64F, (h+1) x (w+1)) over @r. */
+inline double
+box (const cv::Mat &I, const cv::Rect &r)
+{
+  return I.at<double> (r.y + r.height, r.x + r.width) - I.at<double> (r.y, r.x + r.width) -
+         I.at<double> (r.y + r.height, r.x) + I.at<double> (r.y, r.x);
+}
+
+std::unique_ptr<Geometry>
+build_geometry (int h, int w)
+{
+  auto g = std::make_unique<Geometry> ();
+  g->h = h; g->w = w;
+  g->H = cv::getOptimalDFTSize (2 * h);
+  g->W = cv::getOptimalDFTSize (2 * w);
+  const double need = kMinOverlap * h * w;
+  const int max_dy = h / 2, max_dx = w / 2;
+  const cv::Mat ones = cv::Mat::ones (h, w, CV_32F);
+  for (double angle : kAngles)
+    {
+      RotationGeom r;
+      const cv::Mat br = rotate_masked (ones, angle);
+      r.mask = cv::Mat (h, w, CV_64F);
+      for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++)
+          r.mask.at<double> (y, x) = std::isnan (br.at<float> (y, x)) ? 0.0 : 1.0;
+      r.one = padded_dft (r.mask, g->H, g->W);
+      cv::Mat I;
+      cv::integral (r.mask, I, CV_64F);
+      for (int dy = -max_dy; dy <= max_dy; dy++)
+        {
+          const int iy = (dy % g->H + g->H) % g->H;
+          const double hh = h - std::abs (dy);
+          for (int dx = -max_dx; dx <= max_dx; dx++)
+            {
+              if (hh * (w - std::abs (dx)) < need)
+                continue;
+              const int ix = (dx % g->W + g->W) % g->W;
+              /* gallery pixels p with p + s inside the h x w probe */
+              const int y0 = std::max (0, -dy), y1 = std::min (h, h - dy);
+              const int x0 = std::max (0, -dx), x1 = std::min (w, w - dx);
+              const cv::Rect rc (x0, y0, x1 - x0, y1 - y0);
+              const double cnt = std::round (box (I, rc));
+              if (cnt < need)
+                continue;
+              r.idx.push_back (iy * g->W + ix);
+              r.inv_cnt.push_back (1.0 / cnt);
+              r.rect.push_back (rc);
+            }
+        }
+      g->rot.push_back (std::move (r));
+    }
+  return g;
+}
+
+const Geometry &
+geometry (int h, int w)
+{
+  static std::mutex lock;
+  static std::vector<std::unique_ptr<Geometry>> cache;
+  std::lock_guard<std::mutex> guard (lock);
+  for (const auto &g : cache)
+    if (g->h == h && g->w == w)
+      return *g;
+  cache.push_back (build_geometry (h, w));
+  return *cache.back ();
+}
+
+/* Probe side, per rotation: the image spectrum plus, for every admissible
+ * shift, the probe's sum and variance over that rotation's overlap. These
+ * only involve the shared mask, so they are computed once per probe rather
+ * than once per (probe, gallery sample) pair. */
+struct ProbeSpectrum
+{
+  int h = 0, w = 0;
+  cv::Mat val; /* CCS spectrum of the probe */
+  std::vector<std::vector<double>> sa, va; /* [rotation][shift] */
+};
+
+/* Gallery side, per rotation: masked-image spectrum, and for every shift its
+ * sum and variance over the overlap. */
+struct GallerySpectrum
+{
+  int h = 0, w = 0;
+  std::vector<cv::Mat> val;
+  std::vector<std::vector<double>> sb, vb;
+};
+
+ProbeSpectrum
+probe_spectrum (const cv::Mat &a32)
+{
+  ProbeSpectrum s;
+  s.h = a32.rows; s.w = a32.cols;
+  const Geometry &geo = geometry (s.h, s.w);
+  cv::Mat a;
+  a32.convertTo (a, CV_64F);
+  s.val = padded_dft (a, geo.H, geo.W);
+  const cv::Mat sq = padded_dft (a.mul (a), geo.H, geo.W);
+  for (const RotationGeom &r : geo.rot)
+    {
+      const cv::Mat sa = xcorr (s.val, r.one), saa = xcorr (sq, r.one);
+      const double *pa = sa.ptr<double> (), *paa = saa.ptr<double> ();
+      std::vector<double> va_s (r.idx.size ()), sa_s (r.idx.size ());
+      for (size_t k = 0; k < r.idx.size (); k++)
+        {
+          const double Sa = pa[r.idx[k]];
+          sa_s[k] = Sa;
+          va_s[k] = std::max (paa[r.idx[k]] - Sa * Sa * r.inv_cnt[k], 0.0);
+        }
+      s.sa.push_back (std::move (sa_s));
+      s.va.push_back (std::move (va_s));
+    }
+  return s;
+}
+
+GallerySpectrum
+gallery_spectrum (const cv::Mat &b32)
+{
+  GallerySpectrum out;
+  out.h = b32.rows; out.w = b32.cols;
+  const Geometry &geo = geometry (out.h, out.w);
+  for (size_t ri = 0; ri < geo.rot.size (); ri++)
+    {
+      const RotationGeom &r = geo.rot[ri];
+      const cv::Mat br = rotate_masked (b32, kAngles[ri]);
+      cv::Mat bz (out.h, out.w, CV_64F);
+      for (int y = 0; y < out.h; y++)
+        {
+          const float *src = br.ptr<float> (y);
+          double *z = bz.ptr<double> (y);
+          for (int x = 0; x < out.w; x++)
+            z[x] = std::isnan (src[x]) ? 0.0 : src[x];
+        }
+      out.val.push_back (padded_dft (bz, geo.H, geo.W));
+      cv::Mat I, I2;
+      cv::integral (bz, I, I2, CV_64F, CV_64F);
+      std::vector<double> sb (r.idx.size ()), vb (r.idx.size ());
+      for (size_t k = 0; k < r.idx.size (); k++)
+        {
+          const double Sb = box (I, r.rect[k]);
+          sb[k] = Sb;
+          vb[k] = std::max (box (I2, r.rect[k]) - Sb * Sb * r.inv_cnt[k], 0.0);
+        }
+      out.sb.push_back (std::move (sb));
+      out.vb.push_back (std::move (vb));
+    }
+  return out;
+}
+
+double
+ncc_masked_fft (const ProbeSpectrum &a, const GallerySpectrum &g)
+{
+  if (g.h != a.h || g.w != a.w)
+    return 0.0;
+  const Geometry &geo = geometry (a.h, a.w);
+  double best = -1.0;
+  for (size_t ri = 0; ri < geo.rot.size (); ri++)
+    {
+      const RotationGeom &r = geo.rot[ri];
+      const cv::Mat sab = xcorr (a.val, g.val[ri]);
+      const double *pab = sab.ptr<double> ();
+      const double *Sa = a.sa[ri].data (), *va = a.va[ri].data ();
+      const double *Sb = g.sb[ri].data (), *vb = g.vb[ri].data ();
+      for (size_t k = 0; k < r.idx.size (); k++)
+        {
+          const double cov = pab[r.idx[k]] - Sa[k] * Sb[k] * r.inv_cnt[k];
+          const double v = cov / std::sqrt (va[k] * vb[k] + 1e-9);
+          if (v > best)
+            best = v;
+        }
+    }
+  return best;
+}
+
+} /* namespace */
+
+struct _Egis0570TouchFeatures
+{
+  cv::Mat image; /* CV_32F, half resolution, z-scored high-pass signal */
+  /* Lazily computed FFT spectra (see ncc_masked_fft). */
+  bool have_probe = false, have_gallery = false;
+  ProbeSpectrum probe;
+  GallerySpectrum gallery;
+};
+
+double
+fpi_egis0570touch_frame_strength (const uint16_t *frame, const uint16_t *background)
+{
+  if (frame == nullptr || background == nullptr)
+    return 0.0;
+  return frame_strength (frame, background);
+}
+
+void
+fpi_egis0570touch_dump_frames (const char *tag, const uint16_t *frames, guint frame_count,
+                               const uint16_t *background)
+{
+  const char *dir = getenv ("EGIS0570_DUMP_DIR");
+  if (!dir || !frames || !background)
+    return;
+  const long long t = static_cast<long long> (g_get_real_time ());
+  for (guint i = 0; i < frame_count; i++)
+    {
+      char path[512];
+      snprintf (path, sizeof path, "%s/%lld_%s_f%02u_raw.pgm", dir, t, tag ? tag : "x", i);
+      FILE *f = fopen (path, "wb");
+      if (!f)
+        return;
+      fprintf (f, "P5\n%d %d\n65535\n", EGIS0570TOUCH_WIDTH, EGIS0570TOUCH_HEIGHT * 2);
+      const uint16_t *frame = frames + static_cast<size_t> (i) * kFramePixels;
+      for (size_t k = 0; k < kFramePixels; k++)
+        { fputc (frame[k] >> 8, f); fputc (frame[k] & 255, f); }
+      for (size_t k = 0; k < kFramePixels; k++)
+        { fputc (background[k] >> 8, f); fputc (background[k] & 255, f); }
+      fclose (f);
+    }
+}
+
+Egis0570TouchFeatures *
+fpi_egis0570touch_features_extract (const uint16_t *frames,
+                                  guint           frame_count,
+                                  const uint16_t *background,
+                                  gboolean        prefer_strongest) try
+{
+  if (frames == nullptr || background == nullptr || frame_count == 0)
+    return nullptr;
+
+  guint chosen = frame_count - 1;
+  if (prefer_strongest)
+    {
+      double best = -1.0;
+      for (guint i = 0; i < frame_count; i++)
+        {
+          const double s = frame_strength (frames + i * kFramePixels, background);
+          if (s > best)
+            {
+              best = s;
+              chosen = i;
+            }
+        }
+    }
+
+  const uint16_t *frame = frames + chosen * kFramePixels;
+  cv::Mat half = prepare_hp (frame, background);
+  if (half.empty ())
+    return nullptr;
+
+  auto features = std::make_unique<_Egis0570TouchFeatures> ();
+  features->image = std::move (half);
+  return features.release ();
+}
+catch (const std::exception &)
+{
+  /* No C++ exception may escape into the C driver; NULL requests a retry. */
+  return nullptr;
+}
+
+/* Blob layout, little endian:
+ *   magic u32 | version u16 | width u16 | height u16 | reserved u16 |
+ *   resize_scale f32 | quant_scale f32 | width*height * (int16 LE)
+ *
+ * Pixel values are the z-scored high-pass signal, quantised by multiplying
+ * by quant_scale and rounding to the nearest int16. This is version 2 of
+ * the format; version 1 (SIFT keypoints/descriptors) is a different, now
+ * unsupported, encoding -- fpi_egis0570touch_features_deserialise() rejects
+ * it so old templates score 0 against every sample until the user
+ * re-enrolls, rather than being misinterpreted as image data.
+ */
+GBytes *
+fpi_egis0570touch_features_serialise (Egis0570TouchFeatures *features) try
+{
+  if (features == nullptr || features->image.empty ())
+    return nullptr;
+
+  const int width = features->image.cols;
+  const int height = features->image.rows;
+  const size_t pixels = static_cast<size_t> (width) * height;
+  const size_t size = 20 + pixels * sizeof (int16_t);
+
+  g_autofree uint8_t *buffer = static_cast<uint8_t *> (g_malloc (size));
+  size_t offset = 0;
+
+  write_u32_le (buffer + offset, kBlobMagic); offset += 4;
+  write_u16_le (buffer + offset, kBlobVersion); offset += 2;
+  write_u16_le (buffer + offset, static_cast<uint16_t> (width)); offset += 2;
+  write_u16_le (buffer + offset, static_cast<uint16_t> (height)); offset += 2;
+  write_u16_le (buffer + offset, 0); offset += 2; /* reserved */
+  write_float_le (buffer + offset, static_cast<float> (kDownscale)); offset += 4;
+  write_float_le (buffer + offset, kQuantScale); offset += 4;
+
+  for (int y = 0; y < height; y++)
+    {
+      const float *row = features->image.ptr<float> (y);
+      for (int x = 0; x < width; x++)
+        {
+          const float scaled = row[x] * kQuantScale;
+          const float clamped = std::clamp (scaled, -32767.0f, 32767.0f);
+          write_i16_le (buffer + offset, static_cast<int16_t> (std::lround (clamped)));
+          offset += sizeof (int16_t);
+        }
+    }
+
+  return g_bytes_new_take (g_steal_pointer (&buffer), size);
+}
+catch (const std::exception &)
+{
+  return nullptr;
+}
+
+Egis0570TouchFeatures *
+fpi_egis0570touch_features_deserialise (GBytes *blob) try
+{
+  if (blob == nullptr)
+    return nullptr;
+  gsize size = 0;
+  const auto *buffer = static_cast<const uint8_t *> (g_bytes_get_data (blob, &size));
+
+  if (buffer == nullptr || size < 20)
+    return nullptr;
+
+  const uint32_t magic = read_u32_le (buffer);
+  const uint16_t version = read_u16_le (buffer + 4);
+  const uint16_t width = read_u16_le (buffer + 6);
+  const uint16_t height = read_u16_le (buffer + 8);
+  const float resize_scale = read_float_le (buffer + 12);
+  const float quant_scale = read_float_le (buffer + 16);
+
+  if (magic != kBlobMagic || version != kBlobVersion)
+    return nullptr;
+  if (width == 0 || height == 0 || width > 4096 || height > 4096)
+    return nullptr;
+  if (!std::isfinite (resize_scale) || !std::isfinite (quant_scale) || quant_scale <= 0)
+    return nullptr;
+
+  const size_t pixels = static_cast<size_t> (width) * height;
+  const size_t expected = 20 + pixels * sizeof (int16_t);
+  if (size != expected)
+    return nullptr;
+
+  auto features = std::make_unique<_Egis0570TouchFeatures> ();
+  features->image = cv::Mat (height, width, CV_32F);
+
+  size_t offset = 20;
+  for (int y = 0; y < height; y++)
+    {
+      float *row = features->image.ptr<float> (y);
+      for (int x = 0; x < width; x++)
+        {
+          row[x] = static_cast<float> (read_i16_le (buffer + offset)) / quant_scale;
+          offset += sizeof (int16_t);
+        }
+    }
+
+  return features.release ();
+}
+catch (const std::exception &)
+{
+  return nullptr;
+}
+
+double
+fpi_egis0570touch_features_compare (Egis0570TouchFeatures *probe,
+                                  Egis0570TouchFeatures *gallery) try
+{
+  if (probe == nullptr || gallery == nullptr)
+    return 0.0;
+  if (probe->image.empty () || gallery->image.empty ())
+    return 0.0;
+  if (probe->image.rows != gallery->image.rows || probe->image.cols != gallery->image.cols)
+    return 0.0;
+
+  if (!probe->have_probe)
+    {
+      probe->probe = probe_spectrum (probe->image);
+      probe->have_probe = true;
+    }
+  if (!gallery->have_gallery)
+    {
+      gallery->gallery = gallery_spectrum (gallery->image);
+      gallery->have_gallery = true;
+    }
+  return ncc_masked_fft (probe->probe, gallery->gallery);
+}
+catch (const std::exception &)
+{
+  /* A failed comparison must never authenticate. */
+  return 0.0;
+}
+
+void
+fpi_egis0570touch_features_free (Egis0570TouchFeatures *features)
+{
+  delete features;
+}
