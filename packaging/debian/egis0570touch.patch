diff --git a/tests/test-egis0570touch-driver.c b/tests/test-egis0570touch-driver.c
new file mode 100644
index 0000000..c418052
--- /dev/null
+++ b/tests/test-egis0570touch-driver.c
@@ -0,0 +1,451 @@
+/* Synthetic capture/worker tests, not biometric accuracy tests. LGPL-2.1-or-later.
+ * Include the driver to exercise its private state without exporting test APIs.
+ * USB entry points are replaced; no physical reader or fingerprint data is used.
+ */
+#include "drivers/egis0570touch.c"
+
+static void fake_open (FpDevice *dev) { fpi_device_open_complete (dev, NULL); }
+static void fake_close (FpDevice *dev) { fpi_device_close_complete (dev, NULL); }
+static void fake_start (FpDevice *dev) { }
+
+static FpDeviceEgis0570Touch *
+new_device (void)
+{
+  g_autoptr(FpDeviceClass) klass = g_type_class_ref (fpi_device_egis0570touch_get_type ());
+  klass->type = FP_DEVICE_TYPE_VIRTUAL;
+  klass->open = fake_open;
+  klass->close = fake_close;
+  klass->verify = fake_start;
+  klass->enroll = fake_start;
+  FpDeviceEgis0570Touch *self = g_object_new (fpi_device_egis0570touch_get_type (), NULL);
+  g_assert_true (fp_device_open_sync (FP_DEVICE (self), NULL, NULL));
+  return self;
+}
+
+static void
+discard_operation (GObject *object, GAsyncResult *result, gpointer user_data)
+{
+  gboolean *done = user_data;
+  g_autoptr(GError) error = NULL;
+  g_assert_false (g_task_propagate_boolean (G_TASK (result), &error));
+  g_assert_nonnull (error);
+  *done = TRUE;
+}
+
+static void
+capture (gconstpointer action_ptr)
+{
+  FpiDeviceAction action = GPOINTER_TO_INT (action_ptr);
+  g_autoptr(FpDeviceEgis0570Touch) self = new_device ();
+  FpDevice *dev = FP_DEVICE (self);
+  g_autoptr(FpPrint) print = g_object_ref_sink (fp_print_new (dev));
+  gboolean done = FALSE;
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    fp_device_enroll (dev, print, NULL, NULL, NULL, NULL, discard_operation, &done);
+  else
+    {
+      fpi_print_set_type (print, FPI_PRINT_RAW);
+      fp_device_verify (dev, print, NULL, NULL, NULL, NULL, discard_operation, &done);
+    }
+  g_assert_cmpint (fpi_device_get_current_action (dev), ==, action);
+
+  /* First empty packet calibrates; two foreground packets yield ten frames. */
+  memset (self->packet, 0, sizeof (self->packet));
+  g_assert_false (process_packet (dev));
+  memset (self->packet, 100, sizeof (self->packet));
+  g_assert_false (process_packet (dev));
+  g_assert_cmpuint (self->frame_count, ==, 5);
+  g_assert_cmpint (process_packet (dev), ==, action != FPI_DEVICE_ACTION_ENROLL);
+  g_assert_cmpuint (self->frame_count, ==, AUTH_FRAMES);
+  g_assert_true (self->present);
+
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      for (guint i = 0; i < 20; i++)
+        g_assert_false (process_packet (dev));
+      g_assert_cmpuint (self->frame_count, ==, MAX_FRAMES);
+    }
+  else
+    {
+      /* A subsequent operation must not collect the same held touch again. */
+      self->wait_for_removal = self->present;
+      self->frame_count = 0;
+      for (guint i = 0; i < 3; i++)
+        g_assert_false (process_packet (dev));
+      g_assert_cmpuint (self->frame_count, ==, 0);
+    }
+  memset (self->packet, 0, sizeof (self->packet));
+  g_assert_cmpint (process_packet (dev), ==, action == FPI_DEVICE_ACTION_ENROLL);
+  g_assert_false (self->present);
+  g_assert_false (self->wait_for_removal);
+  self->frame_count = 0;
+  memset (self->packet, 100, sizeof (self->packet));
+  g_assert_false (process_packet (dev));
+  g_assert_cmpuint (self->frame_count, ==, 5);
+
+  fpi_device_action_error (dev, fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
+  while (!done)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (fp_device_close_sync (dev, NULL, NULL));
+}
+
+static void
+worker_done (GObject *object, GAsyncResult *result, gpointer user_data)
+{
+  GAsyncResult **saved = user_data;
+  *saved = g_object_ref (result);
+}
+
+static void
+worker (gconstpointer cancel_ptr)
+{
+  gboolean cancel = GPOINTER_TO_INT (cancel_ptr);
+  g_autoptr(FpDeviceEgis0570Touch) self = new_device ();
+  g_autoptr(GCancellable) cancellable = g_cancellable_new ();
+  g_autoptr(GAsyncResult) result = NULL;
+  g_autoptr(GTask) task = g_task_new (self, cancellable, worker_done, &result);
+  g_autoptr(GError) error = NULL;
+  MatchData *data = g_new0 (MatchData, 1);
+  data->action = FPI_DEVICE_ACTION_VERIFY;
+  data->templates = g_ptr_array_new_with_free_func ((GDestroyNotify) g_variant_unref);
+  g_task_set_task_data (task, data, (GDestroyNotify) match_data_free);
+  self->frame_count = AUTH_FRAMES;
+  memset (self->frames, 0, AUTH_FRAMES * FRAME_PIXELS * sizeof (*self->frames));
+  if (cancel)
+    g_cancellable_cancel (cancellable);
+  g_task_run_in_thread (task, match_frames);
+  while (!result)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_cmpint (g_task_propagate_int (G_TASK (result), &error), ==, -1);
+  if (cancel)
+    g_assert_error (error, G_IO_ERROR, G_IO_ERROR_CANCELLED);
+  else
+    g_assert_error (error, FP_DEVICE_RETRY, FP_DEVICE_RETRY_GENERAL);
+  g_assert_true (fp_device_close_sync (FP_DEVICE (self), NULL, NULL));
+}
+
+static void
+worker_match (gconstpointer identify_ptr)
+{
+  gboolean identify = GPOINTER_TO_INT (identify_ptr);
+  g_autoptr(FpDeviceEgis0570Touch) self = new_device ();
+  g_autoptr(GAsyncResult) result = NULL;
+  g_autoptr(GTask) task = g_task_new (self, NULL, worker_done, &result);
+  MatchData *data = g_new0 (MatchData, 1);
+  data->action = identify ? FPI_DEVICE_ACTION_IDENTIFY : FPI_DEVICE_ACTION_VERIFY;
+  data->templates = g_ptr_array_new_with_free_func ((GDestroyNotify) g_variant_unref);
+  g_task_set_task_data (task, data, (GDestroyNotify) match_data_free);
+  guint32 state = 123456789;
+  for (guint i = 0; i < FRAME_PIXELS; i++)
+    {
+      state ^= state << 13;
+      state ^= state >> 17;
+      state ^= state << 5;
+      self->frames[i] = state & 255;
+    }
+  for (guint i = 1; i < AUTH_FRAMES; i++)
+    memcpy (self->frames + i * FRAME_PIXELS, self->frames, FRAME_PIXELS * sizeof (*self->frames));
+  self->frame_count = AUTH_FRAMES;
+  g_autoptr(Egis0570TouchFeatures) features =
+    fpi_egis0570touch_features_extract (self->frames, 1, self->background, TRUE);
+  g_assert_nonnull (features);
+  g_autoptr(GBytes) blob = fpi_egis0570touch_features_serialise (features);
+  g_assert_nonnull (blob);
+  gsize size;
+  gconstpointer bytes = g_bytes_get_data (blob, &size);
+  GVariantBuilder builder;
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+  for (guint i = 0; i < ENROLL_STAGES; i++)
+    g_variant_builder_add_value (&builder, g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, size, 1));
+  if (identify)
+    g_ptr_array_add (data->templates, g_variant_ref_sink (g_variant_new_tuple (NULL, 0)));
+  g_ptr_array_add (data->templates, g_variant_ref_sink (g_variant_new ("(uaay)", 1u, &builder)));
+  g_task_run_in_thread (task, match_frames);
+  while (!result)
+    g_main_context_iteration (NULL, TRUE);
+  g_autoptr(GError) error = NULL;
+  g_assert_cmpint (g_task_propagate_int (G_TASK (result), &error), ==, identify ? 1 : 0);
+  g_assert_no_error (error);
+  g_assert_true (fp_device_close_sync (FP_DEVICE (self), NULL, NULL));
+}
+
+/* Side-store round trip, keyed per template, capped at ADAPT_MAX, and
+ * picked up by gallery_load(); never touches the real /var/lib/fprint. */
+static void
+adaptive_store (void)
+{
+  g_autofree char *dir = g_dir_make_tmp ("egis-adapt-XXXXXX", NULL);
+  g_assert_nonnull (dir);
+  g_setenv ("EGIS0570_ADAPT_DIR", dir, TRUE);
+  g_setenv ("EGIS0570_ADAPT", "1", TRUE);
+
+  guint16 frame[FRAME_PIXELS], background[FRAME_PIXELS] = { 0 };
+  guint32 state = 42;
+  for (guint i = 0; i < FRAME_PIXELS; i++)
+    {
+      state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+      frame[i] = state & 255;
+    }
+  g_autoptr(Egis0570TouchFeatures) f = fpi_egis0570touch_features_extract (frame, 1, background, TRUE);
+  g_autoptr(GBytes) blob = fpi_egis0570touch_features_serialise (f);
+  gsize size;
+  gconstpointer bytes = g_bytes_get_data (blob, &size);
+  GVariantBuilder builder;
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+  for (guint i = 0; i < ENROLL_STAGES; i++)
+    g_variant_builder_add_value (&builder, g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, size, 1));
+  g_autoptr(GVariant) tmpl = g_variant_ref_sink (g_variant_new ("(uaay)", 1u, &builder));
+  g_autoptr(GVariant) other = g_variant_ref_sink (g_variant_new ("(uaay)", 1u, NULL));
+
+  g_autoptr(GPtrArray) blobs = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  for (guint i = 0; i < ADAPT_MAX + 5; i++)
+    g_ptr_array_add (blobs, g_bytes_ref (blob));
+  adapt_save (tmpl, blobs);
+
+  g_autoptr(GPtrArray) loaded = adapt_load (tmpl);
+  g_assert_cmpuint (loaded->len, ==, ADAPT_MAX);
+  g_assert_true (g_bytes_equal (g_ptr_array_index (loaded, 0), blob));
+  g_autoptr(GPtrArray) none = adapt_load (other);
+  g_assert_cmpuint (none->len, ==, 0);
+
+  Gallery *g = gallery_load (tmpl);
+  g_assert_nonnull (g);
+  g_assert_cmpuint (g->original->len, ==, ENROLL_STAGES);
+  g_assert_cmpuint (g->learned->len, ==, ADAPT_MAX);
+  gallery_free (g);
+
+  /* A corrupt store must load as empty, not crash or half-load. */
+  g_autofree char *path = adapt_path (tmpl);
+  g_assert_true (g_file_set_contents (path, "EA01garbage", 11, NULL));
+  g_autoptr(GPtrArray) corrupt = adapt_load (tmpl);
+  g_assert_cmpuint (corrupt->len, ==, 0);
+
+  g_setenv ("EGIS0570_ADAPT", "0", TRUE);
+  g = gallery_load (tmpl);
+  g_assert_cmpuint (g->learned->len, ==, 0);
+  gallery_free (g);
+
+  g_unlink (path);
+  g_rmdir (dir);
+}
+
+/* Verify/identify started with a finger already down must capture it at once
+ * (the locker restarts the operation under a resting finger); enrollment
+ * still waits for a lift so one touch never fills two stages. */
+static void
+held_at_start (gconstpointer action_ptr)
+{
+  FpiDeviceAction action = GPOINTER_TO_INT (action_ptr);
+  g_autoptr(FpDeviceEgis0570Touch) self = new_device ();
+  FpDevice *dev = FP_DEVICE (self);
+  g_autoptr(FpPrint) print = g_object_ref_sink (fp_print_new (dev));
+  gboolean done = FALSE;
+  self->calibrated = TRUE;
+  memset (self->background, 0, sizeof (self->background));
+  self->present = TRUE; /* previous operation ended with the finger down */
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    fp_device_enroll (dev, print, NULL, NULL, NULL, NULL, discard_operation, &done);
+  else
+    {
+      fpi_print_set_type (print, FPI_PRINT_RAW);
+      fp_device_verify (dev, print, NULL, NULL, NULL, NULL, discard_operation, &done);
+    }
+  reset_capture (self, action);
+  memset (self->packet, 100, sizeof (self->packet));
+  if (action == FPI_DEVICE_ACTION_ENROLL)
+    {
+      g_assert_true (self->wait_for_removal);
+      g_assert_false (process_packet (dev));
+      g_assert_cmpuint (self->frame_count, ==, 0);
+    }
+  else
+    {
+      g_assert_false (self->wait_for_removal);
+      g_assert_false (process_packet (dev));
+      g_assert_true (process_packet (dev));
+      g_assert_cmpuint (self->frame_count, ==, AUTH_FRAMES);
+    }
+  fpi_device_action_error (dev, fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
+  while (!done)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (fp_device_close_sync (dev, NULL, NULL));
+}
+
+/* The gallery cache returns the same decoded gallery while the side store is
+ * unchanged, and reloads it once the store is rewritten or removed. */
+static void
+gallery_cache (void)
+{
+  g_autofree char *dir = g_dir_make_tmp ("egis-cache-XXXXXX", NULL);
+  g_setenv ("EGIS0570_ADAPT_DIR", dir, TRUE);
+  g_setenv ("EGIS0570_ADAPT", "1", TRUE);
+  guint16 frame[FRAME_PIXELS], background[FRAME_PIXELS] = { 0 };
+  guint32 state = 7;
+  for (guint i = 0; i < FRAME_PIXELS; i++)
+    {
+      state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+      frame[i] = state & 255;
+    }
+  g_autoptr(Egis0570TouchFeatures) f = fpi_egis0570touch_features_extract (frame, 1, background, TRUE);
+  g_autoptr(GBytes) blob = fpi_egis0570touch_features_serialise (f);
+  gsize size;
+  gconstpointer bytes = g_bytes_get_data (blob, &size);
+  GVariantBuilder builder;
+  g_variant_builder_init (&builder, G_VARIANT_TYPE ("aay"));
+  for (guint i = 0; i < ENROLL_STAGES; i++)
+    g_variant_builder_add_value (&builder, g_variant_new_fixed_array (G_VARIANT_TYPE_BYTE, bytes, size, 1));
+  g_autoptr(GVariant) tmpl = g_variant_ref_sink (g_variant_new ("(uaay)", 1u, &builder));
+
+  Gallery *a = gallery_get (tmpl), *b = gallery_get (tmpl);
+  g_assert_nonnull (a);
+  g_assert_true (a == b);
+  g_assert_cmpuint (a->learned->len, ==, 0);
+  gallery_free (b);
+
+  g_autoptr(GPtrArray) blobs = g_ptr_array_new_with_free_func ((GDestroyNotify) g_bytes_unref);
+  g_ptr_array_add (blobs, g_bytes_ref (blob));
+  adapt_save (tmpl, blobs);
+  Gallery *c = gallery_get (tmpl);
+  g_assert_true (c != a);
+  g_assert_cmpuint (c->learned->len, ==, 1);
+  gallery_free (a);
+
+  g_autofree char *path = adapt_path (tmpl);
+  g_unlink (path);
+  Gallery *d = gallery_get (tmpl);
+  g_assert_true (d != c);
+  g_assert_cmpuint (d->learned->len, ==, 0);
+  gallery_free (c);
+  gallery_free (d);
+  g_rmdir (dir);
+  g_setenv ("EGIS0570_ADAPT", "0", TRUE);
+}
+
+/* Safety defaults: adaptive learning off unless EGIS0570_ADAPT=1, the field
+ * threshold, and no "too hot" model (the locker runs identify for as long as
+ * the screen is locked). Runs first, before main() sets EGIS0570_ADAPT=0. */
+static void
+defaults (void)
+{
+  g_unsetenv ("EGIS0570_ADAPT");
+  g_unsetenv ("EGIS0570_NCC_THRESHOLD");
+  g_assert_false (adapt_enabled ());
+  g_setenv ("EGIS0570_ADAPT", "1", TRUE);
+  g_assert_true (adapt_enabled ());
+  g_unsetenv ("EGIS0570_ADAPT");
+  g_assert_cmpfloat_with_epsilon (match_threshold (), 0.49, 1e-9);
+  FpDeviceClass *cls = g_type_class_ref (fpi_device_egis0570touch_get_type ());
+  g_assert_cmpint (cls->temp_hot_seconds, ==, -1);
+  g_assert_true (cls->features & FP_DEVICE_FEATURE_ALWAYS_ON);
+  g_type_class_unref (cls);
+  /* Learned samples accept only at 0.60, learning needs 0.55 vs the original. */
+  g_assert_cmpfloat_with_epsilon (match_threshold () + ADAPT_LEARNED_MARGIN, 0.60, 1e-9);
+  g_assert_cmpfloat (ADAPT_ANCHOR_SCORE, >, match_threshold ());
+  g_assert_cmpfloat (ADAPT_MIN_SCORE, >=, match_threshold () + ADAPT_LEARNED_MARGIN);
+}
+
+/* A press whose only good match is a learned sample: it must reach 0.60
+ * (0.59 would have passed 0.49 before the margin). An empty learned set
+ * (-1) stays -1. */
+static void
+learned_margin (void)
+{
+  double thr = match_threshold ();
+  g_assert_cmpfloat (learned_score (0.59), <, thr);
+  g_assert_cmpfloat (learned_score (0.601), >=, thr);
+  g_assert_cmpfloat (learned_score (0.498), <, thr);   /* field impostor max vs learned */
+  g_assert_cmpfloat_with_epsilon (learned_score (-1.0), -1.0, 1e-12);
+}
+
+/* A verify running on a fresh device, so finger-status reports are legal. */
+static FpDeviceEgis0570Touch *
+start_verify (FpPrint **print, gboolean *done)
+{
+  FpDeviceEgis0570Touch *self = new_device ();
+  FpDevice *dev = FP_DEVICE (self);
+  *print = g_object_ref_sink (fp_print_new (dev));
+  fpi_print_set_type (*print, FPI_PRINT_RAW);
+  fp_device_verify (dev, *print, NULL, NULL, NULL, NULL, discard_operation, done);
+  reset_capture (self, FPI_DEVICE_ACTION_VERIFY);
+  self->calibrated = FALSE;
+  return self;
+}
+
+static void
+stop_verify (FpDeviceEgis0570Touch *self, FpPrint *print, gboolean *done)
+{
+  FpDevice *dev = FP_DEVICE (self);
+  fpi_device_action_error (dev, fpi_device_error_new (FP_DEVICE_ERROR_GENERAL));
+  while (!*done)
+    g_main_context_iteration (NULL, TRUE);
+  g_assert_true (fp_device_close_sync (dev, NULL, NULL));
+  g_object_unref (print);
+  g_object_unref (self);
+}
+
+/* A reference taken with a finger down must not blind the sensor: the next
+ * empty packet reads below it and triggers recalibration, after which a touch
+ * is detected again. */
+static void
+recalibrate_after_bad_reference (void)
+{
+  FpPrint *print;
+  gboolean done = FALSE;
+  FpDeviceEgis0570Touch *self = start_verify (&print, &done);
+  FpDevice *dev = FP_DEVICE (self);
+  memset (self->packet, 100, sizeof (self->packet));   /* finger at open */
+  g_assert_false (process_packet (dev));
+  g_assert_true (self->calibrated);
+  g_assert_cmpuint (self->background[25 * EGIS0570_IMGWIDTH], ==, 100);
+  memset (self->packet, 100, sizeof (self->packet));   /* still held: invisible */
+  g_assert_false (process_packet (dev));
+  g_assert_false (self->present);
+  memset (self->packet, 0, sizeof (self->packet));     /* lifted: reads below */
+  g_assert_false (process_packet (dev));
+  g_assert_cmpuint (self->background[25 * EGIS0570_IMGWIDTH], ==, 0);
+  memset (self->packet, 100, sizeof (self->packet));   /* next touch is seen */
+  g_assert_false (process_packet (dev));
+  g_assert_true (self->present);
+  stop_verify (self, print, &done);
+}
+
+/* Noise around a correct reference must not cause recalibration. */
+static void
+no_recalibrate_on_noise (void)
+{
+  FpPrint *print;
+  gboolean done = FALSE;
+  FpDeviceEgis0570Touch *self = start_verify (&print, &done);
+  FpDevice *dev = FP_DEVICE (self);
+  memset (self->packet, 60, sizeof (self->packet));
+  g_assert_false (process_packet (dev));
+  for (guint i = 0; i < sizeof (self->packet); i++)
+    self->packet[i] = 60 - (i % 7 == 0 ? RECAL_DROP : 3);   /* 1 in 7 at the limit */
+  g_assert_false (process_packet (dev));
+  g_assert_cmpuint (self->background[25 * EGIS0570_IMGWIDTH], ==, 60);
+  stop_verify (self, print, &done);
+}
+
+int
+main (int argc, char **argv)
+{
+  g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/egis0570touch/defaults", defaults);
+  g_test_add_func ("/egis0570touch/learned-margin", learned_margin);
+  g_test_add_func ("/egis0570touch/recalibrate-bad-reference", recalibrate_after_bad_reference);
+  g_test_add_func ("/egis0570touch/no-recalibrate-on-noise", no_recalibrate_on_noise);
+  /* Tests must never read or write the real adaptive store. */
+  g_setenv ("EGIS0570_ADAPT", "0", TRUE);
+  g_unsetenv ("EGIS0570_DUMP_DIR");
+  g_test_add_func ("/egis0570touch/adaptive-store", adaptive_store);
+  g_test_add_func ("/egis0570touch/gallery-cache", gallery_cache);
+  g_test_add_data_func ("/egis0570touch/held-at-start-verify", GINT_TO_POINTER (FPI_DEVICE_ACTION_VERIFY), held_at_start);
+  g_test_add_data_func ("/egis0570touch/held-at-start-enroll", GINT_TO_POINTER (FPI_DEVICE_ACTION_ENROLL), held_at_start);
+  g_test_add_data_func ("/egis0570touch/held-touch", GINT_TO_POINTER (FPI_DEVICE_ACTION_VERIFY), capture);
+  g_test_add_data_func ("/egis0570touch/enroll-release", GINT_TO_POINTER (FPI_DEVICE_ACTION_ENROLL), capture);
+  g_test_add_data_func ("/egis0570touch/worker-empty", GINT_TO_POINTER (FALSE), worker);
+  g_test_add_data_func ("/egis0570touch/worker-cancelled", GINT_TO_POINTER (TRUE), worker);
+  g_test_add_data_func ("/egis0570touch/worker-verify", GINT_TO_POINTER (FALSE), worker_match);
+  g_test_add_data_func ("/egis0570touch/worker-identify", GINT_TO_POINTER (TRUE), worker_match);
+  return g_test_run ();
+}
diff --git a/tests/test-egis0570touch.cpp b/tests/test-egis0570touch.cpp
new file mode 100644
index 0000000..6c7a7ab
--- /dev/null
+++ b/tests/test-egis0570touch.cpp
@@ -0,0 +1,210 @@
+/* Tests of storage and failure handling, not biometric accuracy.
+ * See tests/egis0570touch-replay.cpp for accuracy against real captures.
+ * LGPL-2.1-or-later. */
+#include "drivers/egis0570touch-match.h"
+#include <vector>
+#include <cmath>
+#include <cstring>
+#include <algorithm>
+
+namespace {
+
+/* Deterministic xorshift noise, matching the existing driver test's style,
+ * so frames have real (non-flat) variance without needing real captures. */
+std::vector<uint16_t>
+noise_frame (guint32 seed, uint16_t scale = 255)
+{
+  std::vector<uint16_t> frame (EGIS0570TOUCH_WIDTH * EGIS0570TOUCH_HEIGHT);
+  guint32 state = seed;
+  for (auto &pixel : frame)
+    {
+      state ^= state << 13;
+      state ^= state >> 17;
+      state ^= state << 5;
+      pixel = state % (scale + 1);
+    }
+  return frame;
+}
+
+} // namespace
+
+static void empty_input ()
+{
+  std::vector<uint16_t> blank (EGIS0570TOUCH_WIDTH * EGIS0570TOUCH_HEIGHT, 100);
+  g_assert_null (fpi_egis0570touch_features_extract (nullptr, 1, blank.data (), FALSE));
+  g_assert_null (fpi_egis0570touch_features_extract (blank.data (), 0, blank.data (), FALSE));
+  g_assert_cmpfloat (fpi_egis0570touch_features_compare (nullptr, nullptr), ==, 0.0);
+  g_assert_null (fpi_egis0570touch_features_deserialise (nullptr));
+}
+
+/* A frame identical to the background (no finger, or a perfectly flat
+ * capture) must be rejected rather than scored as a degenerate-but-valid
+ * image: it carries no measurable signal. */
+static void degenerate_signal ()
+{
+  std::vector<uint16_t> flat (EGIS0570TOUCH_WIDTH * EGIS0570TOUCH_HEIGHT, 100);
+  g_assert_null (fpi_egis0570touch_features_extract (flat.data (), 1, flat.data (), FALSE));
+  g_assert_null (fpi_egis0570touch_features_extract (flat.data (), 1, flat.data (), TRUE));
+}
+
+/* prefer_strongest=TRUE must pick whichever frame of the press actually has
+ * signal; prefer_strongest=FALSE must always use the last frame -- this is
+ * the enrollment-vs-verify selection policy described in TASK2. */
+static void frame_selection ()
+{
+  std::vector<uint16_t> background (EGIS0570TOUCH_WIDTH * EGIS0570TOUCH_HEIGHT, 100);
+  std::vector<uint16_t> flat = background;
+  std::vector<uint16_t> real_press = noise_frame (42);
+
+  std::vector<uint16_t> frames;
+  frames.insert (frames.end (), real_press.begin (), real_press.end ()); /* frame 0: signal */
+  frames.insert (frames.end (), flat.begin (), flat.end ());             /* frame 1: flat */
+
+  /* Strongest-frame selection finds frame 0 even though it is not last. */
+  g_autoptr(Egis0570TouchFeatures) strongest =
+    fpi_egis0570touch_features_extract (frames.data (), 2, background.data (), TRUE);
+  g_assert_nonnull (strongest);
+
+  /* Last-frame selection picks the flat frame 1 and must fail. */
+  g_assert_null (fpi_egis0570touch_features_extract (frames.data (), 2, background.data (), FALSE));
+}
+
+static void storage_roundtrip ()
+{
+  std::vector<uint16_t> frame = noise_frame (123456789);
+  std::vector<uint16_t> background (frame.size (), 0);
+
+  g_autoptr(Egis0570TouchFeatures) original =
+    fpi_egis0570touch_features_extract (frame.data (), 1, background.data (), TRUE);
+  g_assert_nonnull (original);
+  g_autoptr(GBytes) blob = fpi_egis0570touch_features_serialise (original);
+  g_assert_nonnull (blob);
+  g_autoptr(Egis0570TouchFeatures) restored = fpi_egis0570touch_features_deserialise (blob);
+  g_assert_nonnull (restored);
+
+  double self_score = fpi_egis0570touch_features_compare (original, original);
+  double roundtrip_score = fpi_egis0570touch_features_compare (original, restored);
+  /* Comparing an image against itself with no shift/rotation is a perfect
+   * correlation. */
+  g_assert_cmpfloat (self_score, >, 0.99);
+  /* int16 quantisation must not visibly change the score. */
+  g_assert_cmpfloat (std::fabs (self_score - roundtrip_score), <, 0.01);
+
+  gsize size;
+  const auto *bytes = static_cast<const guint8 *> (g_bytes_get_data (blob, &size));
+  /* magic 0x45543032 little-endian spells "ET02"; version 2. */
+  g_assert_cmphex (bytes[0], ==, 0x32);
+  g_assert_cmphex (bytes[1], ==, 0x30);
+  g_assert_cmphex (bytes[2], ==, 0x54);
+  g_assert_cmphex (bytes[3], ==, 0x45);
+  g_assert_cmphex (bytes[4], ==, 0x03);
+  g_assert_cmphex (bytes[5], ==, 0x00);
+
+  for (gsize len : { gsize (0), gsize (7), gsize (19), size - 1 })
+    {
+      g_autoptr(GBytes) truncated = g_bytes_new (bytes, len);
+      g_assert_null (fpi_egis0570touch_features_deserialise (truncated));
+    }
+
+  std::vector<guint8> damaged (bytes, bytes + size);
+  damaged[0] ^= 1;
+  g_autoptr(GBytes) wrong_magic = g_bytes_new (damaged.data (), damaged.size ());
+  g_assert_null (fpi_egis0570touch_features_deserialise (wrong_magic));
+
+  /* Corrupting the declared width breaks the magic/size cross-check and
+   * must fail closed rather than read past the buffer. */
+  damaged.assign (bytes, bytes + size);
+  damaged[6] = 0xff; damaged[7] = 0xff;
+  g_autoptr(GBytes) bad_dims = g_bytes_new (damaged.data (), damaged.size ());
+  g_assert_null (fpi_egis0570touch_features_deserialise (bad_dims));
+
+  /* An old version-1 (SIFT keypoint blob) template must be rejected, not
+   * misread as image data: it must score 0, prompting re-enrollment. */
+  std::vector<guint8> legacy (8, 0);
+  legacy[0] = 0x31; legacy[1] = 0x30; legacy[2] = 0x54; legacy[3] = 0x45; /* old magic */
+  legacy[4] = 0x01; legacy[5] = 0x00; /* version 1 */
+  g_autoptr(GBytes) legacy_blob = g_bytes_new (legacy.data (), legacy.size ());
+  g_autoptr(Egis0570TouchFeatures) legacy_features =
+    fpi_egis0570touch_features_deserialise (legacy_blob);
+  g_assert_null (legacy_features);
+  g_assert_cmpfloat (fpi_egis0570touch_features_compare (original, legacy_features), ==, 0.0);
+}
+
+/* Two different noise captures must not spuriously correlate above the
+ * threshold just because the comparison never fails outright. */
+static void mismatched_size ()
+{
+  std::vector<uint16_t> frame = noise_frame (7);
+  std::vector<uint16_t> background (frame.size (), 0);
+  g_autoptr(Egis0570TouchFeatures) a =
+    fpi_egis0570touch_features_extract (frame.data (), 1, background.data (), TRUE);
+  g_assert_nonnull (a);
+
+  /* Build a features object from a hand-crafted, differently-sized blob to
+   * exercise the dimension mismatch guard in fpi_egis0570touch_features_compare. */
+  g_autoptr(GBytes) blob = fpi_egis0570touch_features_serialise (a);
+  gsize size;
+  const auto *bytes = static_cast<const guint8 *> (g_bytes_get_data (blob, &size));
+  std::vector<guint8> smaller (bytes, bytes + size);
+  guint16 width = smaller[6] | (smaller[7] << 8);
+  guint16 new_width = width - 1;
+  smaller[6] = new_width & 0xff; smaller[7] = (new_width >> 8) & 0xff;
+  smaller.resize (20 + static_cast<size_t> (new_width) *
+                  (smaller[8] | (smaller[9] << 8)) * 2);
+  g_autoptr(GBytes) smaller_blob = g_bytes_new (smaller.data (), smaller.size ());
+  g_autoptr(Egis0570TouchFeatures) b = fpi_egis0570touch_features_deserialise (smaller_blob);
+  g_assert_nonnull (b);
+  g_assert_cmpfloat (fpi_egis0570touch_features_compare (a, b), ==, 0.0);
+}
+
+/* The FFT matcher must find a pure translation (and a small rotation) of a
+ * capture, and must not correlate two unrelated noise captures. */
+static void shift_and_rotation ()
+{
+  std::vector<uint16_t> big = noise_frame (99);
+  std::vector<uint16_t> background (big.size (), 0);
+  /* Smooth the noise a little so it survives the 0.5x downscale. */
+  std::vector<uint16_t> a (big.size ()), b (big.size ());
+  const int W = EGIS0570TOUCH_WIDTH, H = EGIS0570TOUCH_HEIGHT;
+  auto smooth = [&] (int x, int y) {
+    int s = 0, n = 0;
+    for (int dy = -2; dy <= 2; dy++)
+      for (int dx = -2; dx <= 2; dx++)
+        {
+          int xx = std::clamp (x + dx, 0, W - 1), yy = std::clamp (y + dy, 0, H - 1);
+          s += big[yy * W + xx]; n++;
+        }
+    return static_cast<uint16_t> (s / n);
+  };
+  for (int y = 0; y < H; y++)
+    for (int x = 0; x < W; x++)
+      {
+        a[y * W + x] = smooth (x, y);
+        b[y * W + x] = smooth (std::clamp (x + 8, 0, W - 1), std::clamp (y + 4, 0, H - 1));
+      }
+  g_autoptr(Egis0570TouchFeatures) fa = fpi_egis0570touch_features_extract (a.data (), 1, background.data (), TRUE);
+  g_autoptr(Egis0570TouchFeatures) fb = fpi_egis0570touch_features_extract (b.data (), 1, background.data (), TRUE);
+  g_assert_nonnull (fa);
+  g_assert_nonnull (fb);
+  g_assert_cmpfloat (fpi_egis0570touch_features_compare (fa, fb), >, 0.9);
+  /* Cached spectra must give the same answer on repeated calls. */
+  double s1 = fpi_egis0570touch_features_compare (fa, fb);
+  double s2 = fpi_egis0570touch_features_compare (fa, fb);
+  g_assert_cmpfloat (std::fabs (s1 - s2), <, 1e-12);
+
+  std::vector<uint16_t> other = noise_frame (4242);
+  g_autoptr(Egis0570TouchFeatures) fo = fpi_egis0570touch_features_extract (other.data (), 1, background.data (), TRUE);
+  g_assert_cmpfloat (fpi_egis0570touch_features_compare (fa, fo), <, 0.5);
+}
