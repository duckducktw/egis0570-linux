new file mode 100644
index 0000000..ffa4b1c
--- /dev/null
+++ b/libfprint/drivers/egis0570touch-match.h
@@ -0,0 +1,113 @@
+/* High-pass NCC matching for the EgisTec 1c7a:0570 touch sensor.
+ *
+ * Replaces the earlier SIFT/RANSAC matcher (which scored genuine same-finger
+ * presses at 0 on real hardware) with a direct image correlation: subtract a
+ * Gaussian low-pass to remove slow shading, z-score, downscale, then search
+ * small rotations and full translations for the best normalised
+ * cross-correlation against each enrolled sample.
+ */
+/*
+ * Copyright (C) 2026 Michael Brunner
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#include <glib.h>
+#include <stdint.h>
+
+G_BEGIN_DECLS
+
+/* Geometry and crop used by the Egis capture path. */
+#define EGIS0570TOUCH_WIDTH  114
+#define EGIS0570TOUCH_HEIGHT 57
+/* Ignore edge pixels that are dominated by the sensor border. */
+#define EGIS0570TOUCH_BORDER 3
+
+/* Opaque handle holding the preprocessed image of one capture. */
+typedef struct _Egis0570TouchFeatures Egis0570TouchFeatures;
+
+/**
+ * fpi_egis0570touch_features_extract:
+ * @frames: @frame_count raw frames, each EGIS0570TOUCH_WIDTH * EGIS0570TOUCH_HEIGHT
+ *   uint16 samples in row order
+ * @frame_count: number of frames captured for this press
+ * @background: the empty-sensor reference of the same session
+ * @prefer_strongest: if %TRUE, pick the frame with the strongest foreground
+ *   signal (used for enrollment, where every frame of the press is
+ *   available); if %FALSE, use the last captured frame (used for
+ *   verification, which only keeps the most recent AUTH_FRAMES)
+ *
+ * Builds the high-pass, half-resolution representation of one selected
+ * frame. Returns %NULL if the inputs are structurally invalid, or if the
+ * selected frame carries no measurable signal (e.g. no finger present).
+ *
+ * Returns: (transfer full) (nullable): the features, or %NULL on failure
+ */
+Egis0570TouchFeatures *fpi_egis0570touch_features_extract (const uint16_t *frames,
+                                             guint           frame_count,
+                                             const uint16_t *background,
+                                             gboolean        prefer_strongest);
+
+/**
+ * fpi_egis0570touch_frame_strength:
+ *
+ * Returns: the amount of finger signal in one raw frame (sum of positive
+ *   frame - background over the cropped area); used to rank the frames of
+ *   a verification burst
+ */
+double fpi_egis0570touch_frame_strength (const uint16_t *frame,
+                                         const uint16_t *background);
+
+/**
+ * fpi_egis0570touch_dump_frames:
+ *
+ * Debug aid: when $EGIS0570_DUMP_DIR is set, writes every frame of one press
+ * as <dir>/<usec>_<tag>_f<NN>_raw.pgm (frame stacked over background, 16-bit),
+ * the layout read by scripts/eval_matchers.py. No-op otherwise.
+ */
+void fpi_egis0570touch_dump_frames (const char     *tag,
+                                    const uint16_t *frames,
+                                    guint           frame_count,
+                                    const uint16_t *background);
+
+/**
+ * fpi_egis0570touch_features_serialise:
+ *
+ * Returns: (transfer full): a self-describing byte blob for storage
+ */
+GBytes *fpi_egis0570touch_features_serialise (Egis0570TouchFeatures *features);
+
+/**
+ * fpi_egis0570touch_features_deserialise:
+ *
+ * Returns: (transfer full) (nullable): the features, or %NULL if the blob is
+ *   malformed or of an unknown version (including the old SIFT-era version 1
+ *   blobs, which must fail closed rather than be mis-decoded as images)
+ */
+Egis0570TouchFeatures *fpi_egis0570touch_features_deserialise (GBytes *blob);
+
+/**
+ * fpi_egis0570touch_features_compare:
+ *
+ * Matches @probe against @gallery: rotates @gallery over {-15,-10,...,15}
+ * degrees and searches every translation keeping at least 50% overlap,
+ * reporting the largest normalised cross-correlation found. Uses FFT masked
+ * NCC; the Fourier spectra of both sides are computed on first use and
+ * cached inside the features objects (not thread-safe per object).
+ *
+ * Returns: the best NCC score found, roughly in [-1, 1]; 0 if either
+ *   argument is %NULL or the two images are not comparable
+ */
+double fpi_egis0570touch_features_compare (Egis0570TouchFeatures *probe,
+                                 Egis0570TouchFeatures *gallery);
+
+void fpi_egis0570touch_features_free (Egis0570TouchFeatures *features);
+
+G_DEFINE_AUTOPTR_CLEANUP_FUNC (Egis0570TouchFeatures, fpi_egis0570touch_features_free)
+
+G_END_DECLS
