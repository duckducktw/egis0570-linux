#%PAM-1.0
# /etc/pam.d/kde-fingerprint for the KDE Plasma lock screen (Debian/Ubuntu layout).
# - no pam_kwallet5 in auth: it waits for a password and blocks the unlock
# - unlimited tries / no timeout: the greeter does not restart a finished attempt
# - every non-success becomes PAM_AUTH_ERR via pam_deny: PAM_AUTHINFO_UNAVAIL
#   (fprintd restarting after resume) would otherwise disable fingerprint for
#   the rest of the lock (KDE bug 508247)
auth    requisite                     pam_nologin.so
auth    required                      pam_succeed_if.so user != root quiet_success
auth    [success=done default=ignore] pam_fprintd.so max-tries=1000000 timeout=-1
auth    requisite                     pam_deny.so
@include common-account
session optional                      pam_keyinit.so force revoke
@include common-session
password required                     pam_deny.so
