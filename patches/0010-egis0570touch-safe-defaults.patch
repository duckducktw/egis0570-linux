From a3e4c830fe66f8e5f59111ff3681a9fdd8aa2614 Mon Sep 17 00:00:00 2001
From: duckducktw <211126843+duckducktw@users.noreply.github.com>
Date: Sat, 31 Oct 2026 15:00:13 +0800
Subject: [PATCH] egis0570touch: safe defaults - threshold 0.49, adaptive
 learning opt-in, no thermal model

Field data (41 presses from 4 unenrolled fingers) put the impostor max at
0.468 with 12 presses >= the old 0.38 threshold; two live false accepts
came through learned samples. Raise the default to impostor max + 0.02,
make adaptive learning opt-in (EGIS0570_ADAPT=1), and set
temp_hot_seconds = -1: the screen locker keeps identify running while
locked and the default 3-minute heat model disabled the reader mid-lock.
---
 libfprint/drivers/egis0570touch.c | 22 ++++++++++++++++------
 tests/test-egis0570touch-driver.c | 20 ++++++++++++++++++++
 2 files changed, 36 insertions(+), 6 deletions(-)

diff --git a/libfprint/drivers/egis0570touch.c b/libfprint/drivers/egis0570touch.c
index 4fcf0411..86e2b57f 100644
--- a/libfprint/drivers/egis0570touch.c
+++ b/libfprint/drivers/egis0570touch.c
@@ -17,11 +17,13 @@
 #define AUTH_FRAMES 10
 #define ENROLL_STAGES 20
 #define RELEASE_FRAMES 5
-/* NCC score threshold, calibrated from scripts/loo_eval.py's overlap>=0.5
- * run on datasets/collect1 (genuine median 0.725, min 0.37; impostor max
- * ~0.35 excluding the suspect B_other/1 press -- see REPORT2.md). Override
- * for field tuning without a rebuild. */
-#define MATCH_THRESHOLD_DEFAULT 0.38
+/* NCC score threshold. 0.38 (calibrated on one 10-press impostor finger) let
+ * unenrolled fingers through in the field: on scripts/live3_eval.py with 41
+ * presses from 4 unenrolled fingers, impostor max is 0.468 and 12 score >= 0.38.
+ * 0.49 is that max + 0.02; genuine accept there is ~78% per press, recovered
+ * by the lock screen's unlimited retries. Override with
+ * EGIS0570_NCC_THRESHOLD for field tuning without a rebuild. */
+#define MATCH_THRESHOLD_DEFAULT 0.49
 /* Verification scores these frames of the AUTH_FRAMES burst (chronological
  * slots) and keeps the best: on the cross-session evaluation in
  * scripts/xsession_report.py this lifts the genuine accept rate from 80% to
@@ -112,8 +114,11 @@ adapt_dir (void)
 static gboolean
 adapt_enabled (void)
 {
+  /* Off by default: learned samples widen each finger's coverage, and every
+   * extra sample is another chance for an unenrolled finger to align by
+   * coincidence (two field false accepts came through learned samples). */
   const char *v = getenv ("EGIS0570_ADAPT");
-  return !(v && g_str_equal (v, "0"));
+  return v && g_str_equal (v, "1");
 }
 
 static char *
@@ -921,5 +926,10 @@ fpi_device_egis0570touch_class_init (FpDeviceEgis0570TouchClass *klass)
   dev->enroll = start_operation;
   dev->verify = start_operation;
   dev->identify = start_operation;
+  /* Passive capacitive press sensor polled at idle: it does not heat up, and
+   * the screen locker keeps identify running for as long as the screen is
+   * locked. The default 3-minute "too hot" model would disable the reader
+   * mid-lock and silently stop fingerprint unlock. */
+  dev->temp_hot_seconds = -1;
   fpi_device_class_auto_initialize_features (dev);
 }
diff --git a/tests/test-egis0570touch-driver.c b/tests/test-egis0570touch-driver.c
index fdc1eeb9..877605e2 100644
--- a/tests/test-egis0570touch-driver.c
+++ b/tests/test-egis0570touch-driver.c
@@ -321,10 +321,30 @@ gallery_cache (void)
   g_setenv ("EGIS0570_ADAPT", "0", TRUE);
 }
 
+/* Safety defaults: adaptive learning off unless EGIS0570_ADAPT=1, the field
+ * threshold, and no "too hot" model (the locker runs identify for as long as
+ * the screen is locked). Runs first, before main() sets EGIS0570_ADAPT=0. */
+static void
+defaults (void)
+{
+  g_unsetenv ("EGIS0570_ADAPT");
+  g_unsetenv ("EGIS0570_NCC_THRESHOLD");
+  g_assert_false (adapt_enabled ());
+  g_setenv ("EGIS0570_ADAPT", "1", TRUE);
+  g_assert_true (adapt_enabled ());
+  g_unsetenv ("EGIS0570_ADAPT");
+  g_assert_cmpfloat_with_epsilon (match_threshold (), 0.49, 1e-9);
+  FpDeviceClass *cls = g_type_class_ref (fpi_device_egis0570touch_get_type ());
+  g_assert_cmpint (cls->temp_hot_seconds, ==, -1);
+  g_assert_true (cls->features & FP_DEVICE_FEATURE_ALWAYS_ON);
+  g_type_class_unref (cls);
+}
+
 int
 main (int argc, char **argv)
 {
   g_test_init (&argc, &argv, NULL);
+  g_test_add_func ("/egis0570touch/defaults", defaults);
   /* Tests must never read or write the real adaptive store. */
   g_setenv ("EGIS0570_ADAPT", "0", TRUE);
   g_unsetenv ("EGIS0570_DUMP_DIR");
-- 
