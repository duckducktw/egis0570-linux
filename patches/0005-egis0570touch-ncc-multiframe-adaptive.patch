@@ -0,0 +1,274 @@
+/* Offline leave-one-out replay of the egis0570touch NCC matcher against a
+ * directory of captured presses, mirroring scripts/loo_eval.py's
+ * overlap>=0.5 run so the two can be diffed score-for-score.
+ *
+ * Usage: egis0570touch-replay <dataset-root>
+ *   <dataset-root>/<A_same|A_move|B_other>/<press>/ (last *_raw.pgm), a P5
+ *   16-bit 114x114 image: top 57 rows = frame, bottom 57 rows = background
+ *   (same layout as scripts/eval_matchers.py). Only the lexicographically
+ *   last *_raw.pgm of each press is used, matching the Python reference's
+ *   P[k][0][-1]/P[k][1].
+ *
+ * Not a pass/fail unit test: it prints genuine/impostor score
+ * distributions and per-verify timings for a human (or REPORT2.md) to read.
+ * LGPL-2.1-or-later. */
+#include "drivers/egis0570touch-match.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+namespace fs = std::filesystem;
+
+namespace {
+
+struct PgmImage
+{
+  int width = 0, height = 0;
+  std::vector<uint16_t> data;
+};
+
+bool
+read_pgm (const fs::path &path, PgmImage &out)
+{
+  std::ifstream f (path, std::ios::binary);
+  if (!f)
+    return false;
+  std::string magic;
+  f >> magic;
+  if (magic != "P5")
+    return false;
+  int width, height, maxval;
+  f >> width >> height >> maxval;
+  f.get (); /* single whitespace byte separating header from binary data */
+  if (!f || width <= 0 || height <= 0)
+    return false;
+
+  out.width = width;
+  out.height = height;
+  out.data.resize (static_cast<size_t> (width) * height);
+  if (maxval > 255)
+    {
+      std::vector<unsigned char> buf (out.data.size () * 2);
+      f.read (reinterpret_cast<char *> (buf.data ()), buf.size ());
+      if (!f)
+        return false;
+      for (size_t i = 0; i < out.data.size (); i++)
+        out.data[i] = static_cast<uint16_t> ((buf[2 * i] << 8) | buf[2 * i + 1]);
+    }
+  else
+    {
+      std::vector<unsigned char> buf (out.data.size ());
+      f.read (reinterpret_cast<char *> (buf.data ()), buf.size ());
+      if (!f)
+        return false;
+      for (size_t i = 0; i < out.data.size (); i++)
+        out.data[i] = buf[i];
+    }
+  return true;
+}
+
+/* Finds the lexicographically-last *_raw.pgm in a press directory, matching
+ * Python's sorted(glob.glob(...))[-1] used by scripts/eval_matchers.py. */
+fs::path
+last_raw_pgm (const fs::path &press_dir)
+{
+  std::vector<fs::path> candidates;
+  for (const auto &entry : fs::directory_iterator (press_dir))
+    {
+      const std::string name = entry.path().filename ().string ();
+      if (name.size () > 8 && name.substr (name.size () - 8) == "_raw.pgm")
+        candidates.push_back (entry.path ());
+    }
+  std::sort (candidates.begin (), candidates.end ());
+  return candidates.empty () ? fs::path () : candidates.back ();
+}
+
+struct Sample
+{
+  std::string label;
+  int press = 0;
+  GBytes *blob = nullptr;
+  Egis0570TouchFeatures *features = nullptr;
+};
+
+double
+elapsed_ms (std::chrono::steady_clock::time_point start)
+{
+  return std::chrono::duration<double, std::milli> (std::chrono::steady_clock::now () - start).count ();
+}
+
+} /* namespace */
+
+int
+main (int argc, char **argv)
+{
+  if (argc != 2)
+    {
+      fprintf (stderr, "usage: %s <dataset-root>\n", argv[0]);
+      return 2;
+    }
+  const fs::path root = argv[1];
+
+  double threshold = 0.38;
+  if (const char *override_ = getenv ("EGIS0570_NCC_THRESHOLD"))
+    threshold = atof (override_);
+
+  std::vector<Sample> samples;
+  for (const char *label : { "A_same", "A_move", "B_other" })
+    {
+      fs::path label_dir = root / label;
+      if (!fs::is_directory (label_dir))
+        {
+          fprintf (stderr, "missing %s under %s\n", label, root.c_str ());
+          return 1;
+        }
+      std::vector<int> presses;
+      for (const auto &entry : fs::directory_iterator (label_dir))
+        if (entry.is_directory ())
+          presses.push_back (atoi (entry.path ().filename ().string ().c_str ()));
+      std::sort (presses.begin (), presses.end ());
+
+      for (int press : presses)
+        {
+          fs::path press_dir = label_dir / std::to_string (press);
+          fs::path raw = last_raw_pgm (press_dir);
+          if (raw.empty ())
+            {
+              /* Fail loudly: a press directory with no raw capture would
+               * otherwise silently shrink the gallery/impostor counts. */
+              fprintf (stderr, "no *_raw.pgm found under %s\n", press_dir.c_str ());
+              return 1;
+            }
+          PgmImage img;
+          if (!read_pgm (raw, img) || img.width != EGIS0570TOUCH_WIDTH ||
+              img.height != 2 * EGIS0570TOUCH_HEIGHT)
+            {
+              fprintf (stderr, "bad pgm: %s\n", raw.c_str ());
+              return 1;
+            }
+          const uint16_t *frame = img.data.data ();
+          const uint16_t *background = img.data.data () + EGIS0570TOUCH_WIDTH * EGIS0570TOUCH_HEIGHT;
+
+          Sample s;
+          s.label = label;
+          s.press = press;
+          Egis0570TouchFeatures *extracted =
+            fpi_egis0570touch_features_extract (frame, 1, background, FALSE);
+          if (!extracted)
+            {
+              fprintf (stderr, "no signal: %s\n", raw.c_str ());
+              return 1;
+            }
+          /* Round-trip through the real storage format, like a stored
+           * enrollment sample would be. */
+          s.blob = fpi_egis0570touch_features_serialise (extracted);
+          fpi_egis0570touch_features_free (extracted);
+          s.features = fpi_egis0570touch_features_deserialise (s.blob);
+          if (!s.features)
+            {
+              fprintf (stderr, "roundtrip failed: %s\n", raw.c_str ());
+              return 1;
+            }
+          samples.push_back (s);
+        }
+    }
+
+  std::vector<Sample *> gallery; /* A_same + A_move: the enrollment pool */
+  std::vector<Sample *> impostors;
+  for (auto &s : samples)
+    {
+      if (s.label == "A_same" || s.label == "A_move")
+        gallery.push_back (&s);
+      else
+        impostors.push_back (&s);
+    }
+
+  printf ("presses: gallery(A_same+A_move)=%zu impostor(B_other)=%zu\n",
+          gallery.size (), impostors.size ());
+
+  std::vector<double> genuine;
+  printf ("\n-- genuine (leave-one-out, max over %zu-1 gallery) --\n", gallery.size ());
+  for (Sample *probe : gallery)
+    {
+      double best = -1.0;
+      for (Sample *g : gallery)
+        {
+          if (g == probe)
+            continue;
+          best = std::max (best, fpi_egis0570touch_features_compare (probe->features, g->features));
+        }
+      genuine.push_back (best);
+      printf ("  %-8s %-3d score=%.4f\n", probe->label.c_str (), probe->press, best);
+    }
+
+  std::vector<double> impostor;
+  std::vector<double> verify_ms;
+  printf ("\n-- impostor (B_other, max over %zu-entry gallery) --\n", gallery.size ());
+  for (Sample *probe : impostors)
+    {
+      auto t0 = std::chrono::steady_clock::now ();
+      double best = -1.0;
+      for (Sample *g : gallery)
+        best = std::max (best, fpi_egis0570touch_features_compare (probe->features, g->features));
+      double ms = elapsed_ms (t0);
+      verify_ms.push_back (ms);
+      impostor.push_back (best);
+      printf ("  %-8s %-3d score=%.4f  (%zu-gallery verify took %.1f ms)\n",
+              probe->label.c_str (), probe->press, best, gallery.size (), ms);
+    }
+
+  auto sorted = [] (std::vector<double> v) { std::sort (v.begin (), v.end ()); return v; };
+  auto median = [] (std::vector<double> v) {
+    std::sort (v.begin (), v.end ());
+    size_t n = v.size ();
+    return n % 2 ? v[n / 2] : (v[n / 2 - 1] + v[n / 2]) / 2.0;
+  };
+
+  std::vector<double> gs = sorted (genuine), is = sorted (impostor);
+  printf ("\ngenuine sorted:  ");
+  for (double v : gs) printf ("%.2f ", v);
+  printf ("\nimpostor sorted: ");
+  for (double v : is) printf ("%.2f ", v);
+  printf ("\n");
+
+  int accept = 0;
+  for (double v : genuine)
+    if (v >= threshold)
+      accept++;
+  printf ("\ngenuine median=%.3f min=%.3f | impostor(incl. B1) median=%.3f max=%.3f\n",
+          median (genuine), gs.empty () ? 0.0 : gs.front (),
+          median (impostor), is.empty () ? 0.0 : is.back ());
+  printf ("genuine accept rate @%.2f: %d/%zu (%.0f%%)\n",
+          threshold, accept, genuine.size (), 100.0 * accept / genuine.size ());
+
+  double impostor_max_excl_b1 = -1.0;
+  for (Sample *probe : impostors)
+    {
+      if (probe->press == 1)
+        continue;
+      double best = -1.0;
+      for (Sample *g : gallery)
+        best = std::max (best, fpi_egis0570touch_features_compare (probe->features, g->features));
+      impostor_max_excl_b1 = std::max (impostor_max_excl_b1, best);
+    }
+  printf ("impostor max EXCLUDING B_other/1: %.4f\n", impostor_max_excl_b1);
+
+  if (!verify_ms.empty ())
+    {
+      double min_ms = *std::min_element (verify_ms.begin (), verify_ms.end ());
+      double max_ms = *std::max_element (verify_ms.begin (), verify_ms.end ());
+      double mean_ms = 0;
+      for (double v : verify_ms) mean_ms += v;
+      mean_ms /= verify_ms.size ();
+      printf ("verify timing (1 probe vs %zu-entry gallery), n=%zu: min=%.1fms mean=%.1fms max=%.1fms\n",
+              gallery.size (), verify_ms.size (), min_ms, mean_ms, max_ms);
+    }
+
+  return 0;
+}
