+      for (size_t k = 0; k < r.idx.size (); k++)
         {
-          const int iy = (dy % H + H) % H;
-          const double hh = h - std::abs (dy);
-          for (int dx = -max_dx; dx <= max_dx; dx++)
-            {
-              if (hh * (w - std::abs (dx)) < need)
-                continue;
-              const int ix = (dx % W + W) % W;
-              const double cnt = std::round (r.n.at<double> (iy, ix));
-              if (cnt < need)
-                continue;
-              const double Sa = sa.at<double> (iy, ix), Sb = r.sb.at<double> (iy, ix);
-              const double cov = sab.at<double> (iy, ix) - Sa * Sb / cnt;
-              const double va = std::max (saa.at<double> (iy, ix) - Sa * Sa / cnt, 0.0);
-              const double vb = std::max (r.sbb.at<double> (iy, ix) - Sb * Sb / cnt, 0.0);
-              const double v = cov / std::sqrt (va * vb + 1e-9);
-              if (v > best)
-                best = v;
-            }
+          const double cov = pab[r.idx[k]] - Sa[k] * Sb[k] * r.inv_cnt[k];
+          const double v = cov / std::sqrt (va[k] * vb[k] + 1e-9);
